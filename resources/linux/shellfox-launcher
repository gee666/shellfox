#!/bin/sh
# Shellfox/linux-v1
shellfox_root=/usr/lib/shellfox
# Fixed native application binding. Only the CLI may choose GUI cold fallback.
export SHELLFOX_CLI_LAUNCH=eyJleGVjdXRhYmxlIjoiL3Vzci9saWIvc2hlbGxmb3gvc2hlbGxmb3giLCJhcmdzIjpbXSwiZW52Ijp7fX0=
unset SHELLFOX_PROJECT_ROOT SHELLFOX_RUNTIME_PATH
export SHELLFOX_RESOURCES_PATH="$shellfox_root/resources"
case "$#:${1:-}:${2:-}" in
  1:update:|2:update:--check)
    unset ELECTRON_RUN_AS_NODE
    shift
    exec /bin/sh "$shellfox_root/resources/shellfox-update.sh" "$@"
    ;;
esac
ELECTRON_RUN_AS_NODE=1 exec "$shellfox_root/shellfox" "$shellfox_root/resources/cli/main/cli.cjs" "$@"
