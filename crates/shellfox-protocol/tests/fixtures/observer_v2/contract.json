    "recoveryDecodedBytes": 4194304,
    "dataDecodedBytes": 16384,
    "pollDecodedBytes": 262144,
    "eventsPerPoll": 1024,
    "deadlineMs": 30000,
    "longPollMs": 20000,
    "clientOperations": 8,
    "clientPolls": 1,
    "goSharedOperations": 12,
    "goSharedPolls": 64
  }
