    "settleSession",
    "unsettleSession",
    "deleteSession",
    "clearSessionError",
    "setSessionEnv",
    "setTerminalEnv",
    "setVisibleSessions",
    "attachTerminal",
    "takeTerminalControl",
    "writeTerminal",
    "resizeTerminal",
    "acknowledgeTerminal",
    "detachTerminal",
    "closeTab",
    "listFiles",
