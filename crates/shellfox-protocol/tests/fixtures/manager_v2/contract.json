{
  "version": 2,
  "profile": "manager-v2",
  "inputFormat": "manager-input-v1",
  "devicePolicy": "control-full-account-v1",
  "devicePermission": "write",
  "routes": {
    "discover": "/v2/discover",
    "pair": "/v2/pair",
    "request": "/v2/request",
    "events": "/v2/events",
    "disconnect": "/v2/disconnect"
  },
  "methods": [
    "getSnapshot",
    "getTerminalProfiles",
    "getHomeDirectory",
    "createSession",
    "addTab",
    "activateSession",
    "renameSession",
    "renameTab",
    "reorderTabs",
    "setSessionPinned",
    "settleSession",
    "unsettleSession",
    "deleteSession",
    "clearSessionError",
    "setSessionEnv",
    "setTerminalEnv",
    "setVisibleSessions",
    "attachTerminal",
    "takeTerminalControl",
    "writeTerminal",
    "resizeTerminal",
    "acknowledgeTerminal",
    "detachTerminal",
    "closeTab",
    "listFiles",
    "readFile",
    "writeFile",
    "beginFileRead",
    "readFileChunk",
    "beginFileWrite",
    "writeFileChunk",
    "finishFileWrite",
    "cancelFileTransfer",
    "writeImageFile",
    "readFileAsset",
    "getSessionStats",
    "resolveDirectory",
    "createDirectory",
    "completeDirectory",
    "beginTerminalUpload",
    "writeTerminalUpload",
    "finishTerminalUpload",
    "cancelTerminalUpload"
  ],
  "limits": {
    "requestBytes": 1048576,
    "responseBytes": 8388608,
    "inputBytes": 65536,
    "recoveryBytes": 4194304,
    "dataBytes": 16384,
    "pollDataBytes": 262144,
    "eventsPerPoll": 1024,
    "maxAxis": 32767,
    "maxCells": 1048576,
    "pendingInputs": 16,
    "clientOperations": 8,
    "clientPolls": 1,
    "goSharedOperations": 12,
    "goSharedPolls": 64
  }
}
