new file mode 100644
index 0000000..19f35e1
--- /dev/null
+++ b/include/ghostty/vt/shellfox_ansi.h
@@ -0,0 +1,65 @@
+/* Shellfox additive compatibility extension. MIT, like libghostty-vt. */
+#ifndef GHOSTTY_SHELLFOX_ANSI_H
+#define GHOSTTY_SHELLFOX_ANSI_H
+#include <ghostty/vt/shellfox_extension.h>
+#include <ghostty/vt/color.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define GHOSTTY_SHELLFOX_ANSI_ABI 1u
+#define GHOSTTY_SHELLFOX_TARGET_NATIVE_VT1 0u
+#define GHOSTTY_SHELLFOX_TARGET_LEGACY_XTERM6 1u
+#define GHOSTTY_SHELLFOX_TARGET_KITTY_KEYBOARD (1ull << 0)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_PROFILE (1ull << 0)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_RESET_DEFAULTS (1ull << 1)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_GRAPHICS (1ull << 2)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_METADATA (1ull << 3)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_MODES (1ull << 4)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_CHARSETS (1ull << 5)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_KEYBOARD (1ull << 6)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_CURSOR (1ull << 7)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_REP (1ull << 8)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_SEMANTICS (1ull << 9)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_WIDTH_POLICY (1ull << 10)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_CONTINUATION (1ull << 11)
+#define GHOSTTY_SHELLFOX_UNSUPPORTED_SOURCE_ERROR (1ull << 12)
+typedef struct {
+    size_t size;
+    uint32_t abi_version;
+    uint32_t target;
+    uint64_t target_features;
+    GhosttyString engine_profile;
+    size_t max_output_bytes, max_rows, max_cells, max_continuation_bytes;
+    /* Target reset baseline. Null RGB means unset, not black. */
+    const GhosttyColorRgb *default_foreground, *default_background, *default_cursor;
+    /* NULL means the unmodified upstream palette, otherwise exactly 256 RGBs. */
+    const GhosttyColorRgb *default_palette;
+    uint32_t default_cursor_style;
+    /* -1 = emulator policy, 0 = steady, 1 = blinking. */
+    int32_t default_cursor_blink;
+    uint32_t runtime_resize_pull_scrollback;
+    /* Must be 1: create/configure a fresh passive target before applying bytes. */
+    uint8_t target_is_fresh;
+    /* Exact declared restoration configuration; SIZE_MAX means unlimited. */
+    size_t target_scrollback_max_bytes, target_scrollback_max_rows;
+    uint64_t runtime_image_storage_limit;
+} GhosttyShellfoxAnsiOptions;
+/* Immutable full-for-accepted-profile export, not an arbitrary terminal snapshot.
+ * Preflight returns UNSUPPORTED plus reason bits for inexpressible state.
+ * No bytes are published before preflight and bounded counting succeed.
+ * Requires a fresh target with the same grid and declared baseline/config.
+ * It is not an in-place reset of an arbitrary dirty target. Source access must
+ * be serialized with ALL terminal operations.
+ * NULL/0 queries required capacity; undersized output is left untouched.
+ * Continuation is appended LAST and may be incomplete UTF-8. This is a BYTE
+ * format, not a v1 JSON-string replacement. Receivers must suppress replies
+ * and external effects. No source callbacks are invoked by this function.
+ * On every failure, out_written is zero except OUT_OF_SPACE, where it is the
+ * full required capacity. An old official library does not export this API. */
+GHOSTTY_API GhosttyResult ghostty_terminal_export_ansi_full_buf(
+    GhosttyTerminal terminal, const GhosttyShellfoxAnsiOptions* options,
+    uint8_t* buffer, size_t capacity, size_t* out_written, uint64_t* unsupported);
+#ifdef __cplusplus
+}
+#endif
+#endif
