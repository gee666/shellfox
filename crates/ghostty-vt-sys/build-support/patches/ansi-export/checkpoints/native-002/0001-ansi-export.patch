+const std = @import("std");
+const testing = std.testing;
+const api = @import("../c/shellfox_ansi.zig");
+const term = @import("../c/terminal.zig");
+const snapshot = @import("../c/snapshot.zig");
+const Result = @import("../c/result.zig").Result;
+const lib = @import("../lib.zig");
+const T = @import("types.zig");
+fn new() !term.Terminal {
+    var value: term.Terminal = null;
+    try testing.expectEqual(Result.success, term.new(&lib.alloc.test_allocator, &value, 20, 5));
+    var limit: usize = 65536;
+    try testing.expectEqual(Result.success, term.set(value, .continuation_max_bytes, &limit));
+    return value;
+}
+fn write(t: term.Terminal, bytes: []const u8) void {
+    term.vt_write(t, bytes.ptr, bytes.len);
+}
+fn options(t: term.Terminal) api.Options {
+    const native = term.zigTerminal(t).?;
+    return .{ .engine_profile = .init(T.profile.engine_profile), .target_features = 1, .default_cursor_style = @intCast(@backingInt(native.cursor.default_style)), .default_cursor_blink = if (native.cursor.default_blink) |b| @intFromBool(b) else -1, .runtime_resize_pull_scrollback = @intFromBool(native.flags.resize_pull_scrollback), .target_scrollback_max_bytes = native.screens.get(.primary).?.pages.limits.bytes.explicit, .target_scrollback_max_rows = native.screens.get(.primary).?.pages.limits.lines.explicit, .runtime_image_storage_limit = if (@import("terminal_options").kitty_graphics) native.screens.active.kitty_images.total_limit else 0 };
+}
+fn exportOwned(t: term.Terminal) ![]u8 {
+    var o = options(t);
+    var needed: usize = 0;
+    var reason: u64 = 0;
+    const result = api.export_buf(t, &o, null, 0, &needed, &reason);
+    if (result != .out_of_space) {
+        const native = term.zigTerminal(t).?;
+        std.debug.print("export result={s} reason={x} title={s} pwd={s}\n", .{ @tagName(result), reason, native.getTitle() orelse "", native.getPwd() orelse "" });
+    }
+    try testing.expectEqual(Result.out_of_space, result);
+    const bytes = try testing.allocator.alloc(u8, needed);
+    errdefer testing.allocator.free(bytes);
+    try testing.expectEqual(Result.success, api.export_buf(t, &o, bytes.ptr, bytes.len, &needed, &reason));
+    return bytes;
+}
+fn snapshotOwned(t: term.Terminal) ![]u8 {
+    var n: usize = 0;
+    try testing.expectEqual(Result.out_of_space, snapshot.encode_buf(t, null, 0, &n));
+    const bytes = try testing.allocator.alloc(u8, n);
+    errdefer testing.allocator.free(bytes);
+    try testing.expectEqual(Result.success, snapshot.encode_buf(t, bytes.ptr, bytes.len, &n));
+    return bytes;
+}
+fn same(a: term.Terminal, b: term.Terminal) !void {
+    const x = term.zigTerminal(a).?;
+    const y = term.zigTerminal(b).?;
+    try testing.expectEqual(x.screens.active_key, y.screens.active_key);
+    try testing.expectEqualDeep(x.modes, y.modes);
+    try testing.expectEqual(x.previous_char, y.previous_char);
+    try testing.expectEqual(x.cursor.is_default, y.cursor.is_default);
+    try testing.expectEqual(x.flags.shell_redraws_prompt, y.flags.shell_redraws_prompt);
+    try testing.expectEqual(x.flags.resize_pull_scrollback, y.flags.resize_pull_scrollback);
+    try testing.expectEqualDeep(x.scrolling_region, y.scrolling_region);
+    try testing.expectEqualDeep(x.colors, y.colors);
+    try testing.expectEqualStrings(x.title.items, y.title.items);
+    try testing.expectEqualStrings(x.pwd.items, y.pwd.items);
+    try testing.expectEqual(x.flags.mouse_event, y.flags.mouse_event);
+    try testing.expectEqual(x.flags.mouse_format, y.flags.mouse_format);
+    try testing.expectEqual(x.flags.modify_other_keys_2, y.flags.modify_other_keys_2);
+    for (std.enums.values(@import("../ScreenSet.zig").Key)) |key| {
+        const left = x.screens.get(key);
+        const right = y.screens.get(key);
+        try testing.expectEqual(left != null, right != null);
+        if (left) |s| {
+            const d = right.?;
+            try testing.expectEqualDeep(s.saved_cursor, d.saved_cursor);
+            try testing.expectEqual(s.cursor.x, d.cursor.x);
+            try testing.expectEqual(s.cursor.y, d.cursor.y);
+            try testing.expectEqual(s.cursor.pending_wrap, d.cursor.pending_wrap);
+            try testing.expectEqualDeep(s.cursor.style, d.cursor.style);
+            try testing.expectEqual(s.cursor.cursor_style, d.cursor.cursor_style);
+            try testing.expectEqual(s.cursor.protected, d.cursor.protected);
+            try testing.expectEqual(s.protected_mode, d.protected_mode);
+            try testing.expectEqualDeep(s.charset, d.charset);
+            var f: T.formatter.ScreenFormatter = .init(s, .{ .emit = .vt, .unwrap = false, .trim = false });
+            var g: T.formatter.ScreenFormatter = .init(d, .{ .emit = .vt, .unwrap = false, .trim = false });
+            var first: std.Io.Writer.Allocating = .init(testing.allocator);
+            defer first.deinit();
+            var second: std.Io.Writer.Allocating = .init(testing.allocator);
+            defer second.deinit();
+            try f.format(&first.writer);
+            try g.format(&second.writer);
+            try testing.expectEqualStrings(first.written(), second.written());
+            var ls = s.kitty_keyboard;
+            var rs = d.kitty_keyboard;
+            for (0..9) |_| {
+                try testing.expectEqual(ls.current().int(), rs.current().int());
+                ls.pop(1);
+                rs.pop(1);
+            }
+        }
+    }
+}
+fn roundtrip(input: []const u8, suffix: []const u8) !void {
+    const source = try new();
+    defer term.free(source);
+    const target = try new();
+    defer term.free(target);
+    write(source, input);
+    const before = try snapshotOwned(source);
+    defer testing.allocator.free(before);
+    const bytes = try exportOwned(source);
+    defer testing.allocator.free(bytes);
+    const after = try snapshotOwned(source);
+    defer testing.allocator.free(after);
+    try testing.expectEqualSlices(u8, before, after);
+    write(target, bytes);
+    try same(source, target);
+    write(source, suffix);
+    write(target, suffix);
+    try same(source, target);
+}
+test "Shellfox full ANSI preserves saved cursor, history, styles and REP" {
+    try roundtrip("first\r\nsecond\r\nthird\r\nfourth\r\nfifth\r\nsixth\x1b[2;3H\x1b[31m\x1b7\x1b[4;7H\x1b[32mZ", "\x1b8!\x1b[2b");
+}
+test "Shellfox full ANSI preserves inactive primary and alternate saved cursors" {
+    try roundtrip("primary\x1b[2;2H\x1b7\x1b[?1049h\x1b[Halt\x1b[3;3H\x1b7\x1b[4;4Hz", "\x1b8A\x1b[?1049lB");
+    try roundtrip("primary\x1b[2;2H\x1b7\x1b[?47h\x1b[Halt\x1b[3;3H\x1b7\x1b[4;4Hz\x1b[?47l", "\x1b[?47h\x1b8A");
