+test "Shellfox full ANSI export never replays source PTY or clipboard callbacks" {
+    const Probe = struct {
+        pty: usize = 0,
+        clipboard: usize = 0,
+        fn ptyWrite(_: term.Terminal, userdata: ?*anyopaque, _: [*]const u8, n: usize) callconv(.c) void {
+            const self: *@This() = @ptrCast(@alignCast(userdata.?));
+            self.pty += n;
+        }
+        fn clipboardWrite(_: term.Terminal, userdata: ?*anyopaque, _: *const term.ClipboardWrite) callconv(.c) void {
+            const self: *@This() = @ptrCast(@alignCast(userdata.?));
+            self.clipboard += 1;
+        }
+    };
+    const t = try new();
+    defer term.free(t);
+    var probe: Probe = .{};
+    try testing.expectEqual(Result.success, term.set(t, .userdata, &probe));
+    try testing.expectEqual(Result.success, term.set(t, .write_pty, @ptrCast(&Probe.ptyWrite)));
+    try testing.expectEqual(Result.success, term.set(t, .clipboard_write, @ptrCast(&Probe.clipboardWrite)));
