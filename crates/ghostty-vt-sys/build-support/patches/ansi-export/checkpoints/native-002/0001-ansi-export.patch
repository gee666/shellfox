diff --git a/src/terminal/c/shellfox_ansi.zig b/src/terminal/c/shellfox_ansi.zig
new file mode 100644
index 0000000..7da594a
--- /dev/null
+++ b/src/terminal/c/shellfox_ansi.zig
@@ -0,0 +1,141 @@
+//! Shellfox additive compatibility ABI. Existing C entry points are unchanged.
+const std = @import("std");
+const lib = @import("../lib.zig");
+const Result = @import("result.zig").Result;
+const terminal = @import("terminal.zig");
+const core = @import("../shellfox_ansi/main.zig");
+const profile = @import("../shellfox_profile.zig");
+const width = @import("../shellfox_unicode_v6.zig");
+pub const Options = core.Options;
+pub const ExtensionInfo = extern struct {
+    size: usize = @sizeOf(ExtensionInfo),
+    abi_version: u32 = 1,
+    ansi_abi_version: u32 = 0,
+    terminal_profile_abi_version: u32 = 0,
+    snapshot_budget_abi_version: u32 = 0,
+    snapshot_format_version: u32 = 0,
+    features: u64 = 0,
+    engine_profile: lib.String = .init(@as([]const u8, "")),
+    legacy_width_profile: lib.String = .init(@as([]const u8, "")),
+};
+pub fn extension_info(out_: ?*ExtensionInfo) callconv(lib.calling_conv) Result {
+    const out = out_ orelse return .invalid_value;
+    if (out.size != @sizeOf(ExtensionInfo)) return .invalid_value;
+    if (out.abi_version != 1) return .invalid_value;
+    out.* = .{
+        .ansi_abi_version = if (lib.feature(.formatter)) profile.ansi_abi_version else 0,
+        .terminal_profile_abi_version = profile.terminal_profile_abi_version,
+        .snapshot_budget_abi_version = profile.snapshot_budget_abi_version,
+        .snapshot_format_version = if (lib.feature(.snapshot)) @import("../snapshot/envelope.zig").version else 0,
+        .features = @as(u64, if (lib.feature(.formatter)) 1 else 0) |
+            @as(u64, if (profile.snapshot_budget_abi_version > 0) 2 else 0) |
+            @as(u64, if (profile.terminal_profile_abi_version > 0) 4 else 0),
+        .engine_profile = .init(profile.engine_profile),
+        .legacy_width_profile = .init(@as([]const u8, width.profile)),
+    };
+    return .success;
+}
+const Counter = struct {
+    writer: std.Io.Writer,
+    limit: usize,
+    count: usize = 0,
+    exceeded: bool = false,
+    fn init(limit: usize) Counter {
+        return .{ .writer = .{ .vtable = &.{ .drain = drain }, .buffer = &.{} }, .limit = limit };
+    }
+    fn drain(w: *std.Io.Writer, data: []const []const u8, splat: usize) std.Io.Writer.Error!usize {
+        const self: *Counter = @alignCast(@fieldParentPtr("writer", w));
+        const last = data.len - 1;
+        var n = std.math.mul(usize, data[last].len, splat) catch {
+            self.exceeded = true;
+            return error.WriteFailed;
+        };
+        for (data[0..last]) |s| n = std.math.add(usize, n, s.len) catch {
+            self.exceeded = true;
+            return error.WriteFailed;
+        };
+        if (n > self.limit - self.count or w.end > self.limit - self.count - n) {
+            self.exceeded = true;
+            return error.WriteFailed;
+        }
+        self.count += n + w.end;
+        w.end = 0;
+        return n;
+    }
+};
+pub fn export_buf(terminal_: terminal.Terminal, options_: ?*const Options, buffer: ?[*]u8, capacity: usize, written_: ?*usize, unsupported_: ?*u64) callconv(lib.calling_conv) Result {
+    const written = written_ orelse return .invalid_value;
+    written.* = 0;
+    const unsupported = unsupported_ orelse return .invalid_value;
+    unsupported.* = 0;
+    if (comptime !lib.feature(.formatter)) return .unsupported;
+    const t = terminal.zigTerminal(terminal_) orelse return .invalid_value;
+    const options = options_ orelse return .invalid_value;
+    if (!options.valid() or (buffer == null and capacity != 0)) return .invalid_value;
+    var source_failed = false;
+    const status = terminal.get(terminal_, .vt_processing_error, &source_failed);
+    if (status != .success) return status;
+    if (source_failed) {
+        unsupported.* = core.Reason.source_error;
+        return .unsupported;
+    }
+    const plan = core.preflight(t, options) catch return .limit_exceeded;
+    unsupported.* = plan.unsupported;
+    if (unsupported.* != 0) return .unsupported;
+    const allocator = lib.alloc.default(null);
+    var continuation: []u8 = &.{};
+    defer allocator.free(continuation);
+    var ground = false;
+    const ground_result = terminal.get(terminal_, .vt_ground, &ground);
+    if (ground_result != .success) return ground_result;
+    if (!ground) {
+        var needed: usize = 0;
+        const result = terminal.continuation_buf(terminal_, null, 0, &needed);
+        if (result != .out_of_space and result != .success) {
+            unsupported.* = core.Reason.continuation;
+            return .unsupported;
+        }
+        if (needed > options.max_continuation_bytes) return .limit_exceeded;
+        continuation = allocator.alloc(u8, needed) catch return .out_of_memory;
+        const copied = terminal.continuation_buf(terminal_, continuation.ptr, continuation.len, &needed);
+        if (copied != .success or needed != continuation.len) return .invalid_value;
+    }
+    var counter: Counter = .init(options.max_output_bytes);
+    core.format(t, options, plan, continuation, &counter.writer) catch {
+        return if (counter.exceeded) .limit_exceeded else .io_error;
+    };
+    const required = counter.count + counter.writer.end;
+    if (required > options.max_output_bytes) return .limit_exceeded;
+    written.* = required;
+    if (buffer == null or capacity < required) return .out_of_space;
+    const staged = allocator.alloc(u8, required) catch {
+        written.* = 0;
+        return .out_of_memory;
+    };
+    defer allocator.free(staged);
+    var writer: std.Io.Writer = .fixed(staged);
+    core.format(t, options, plan, continuation, &writer) catch {
+        written.* = 0;
+        return .io_error;
+    };
+    if (writer.end != required) {
+        written.* = 0;
+        return .io_error;
+    }
+    @memcpy(buffer.?[0..required], staged);
+    return .success;
+}
+test "Shellfox extension-info rejects unknown layout/version and reports compiled features" {
+    var info: ExtensionInfo = .{};
+    try std.testing.expectEqual(Result.success, extension_info(&info));
+    try std.testing.expectEqual(profile.snapshot_budget_abi_version, info.snapshot_budget_abi_version);
+    info.abi_version = 2;
+    try std.testing.expectEqual(Result.invalid_value, extension_info(&info));
+    info = .{};
+    info.size -= 1;
+    try std.testing.expectEqual(Result.invalid_value, extension_info(&info));
+}
+test {
+    _ = core;
+    _ = profile;
+}
diff --git a/src/terminal/shellfox_ansi/cursor.zig b/src/terminal/shellfox_ansi/cursor.zig
new file mode 100644
index 0000000..ab90a91
--- /dev/null
+++ b/src/terminal/shellfox_ansi/cursor.zig
@@ -0,0 +1,110 @@
+//! State emitters adapted from formatter.zig, under the same MIT license.
+const std = @import("std");
+const T = @import("types.zig");
+const charsets = @import("../charsets.zig");
+const Style = @import("../style.zig").Style;
+pub fn charset(state: T.Screen.CharsetState, singles: bool, w: *std.Io.Writer) !void {
+    for (std.enums.values(charsets.Slots)) |slot| {
+        const value = state.charsets.get(slot);
+        const final: ?u8 = switch (value) {
+            .utf8 => null,
+            .ascii => 'B',
+            .british => 'A',
+            .dec_special => '0',
+        };
+        if (final) |v| try w.print("\x1b{c}{c}", .{ switch (slot) {
+            .G0 => @as(u8, '('),
+            .G1 => ')',
+            .G2 => '*',
+            .G3 => '+',
+        }, v });
+    }
+    try w.writeAll(switch (state.gl) {
+        .G0 => "\x0f",
+        .G1 => "\x0e",
+        .G2 => "\x1bn",
+        .G3 => "\x1bo",
+    });
+    try w.writeAll(switch (state.gr) {
+        .G0 => unreachable,
+        .G1 => "\x1b~",
+        .G2 => "\x1b}",
+        .G3 => "\x1b|",
+    });
+    if (singles) if (state.single_shift) |slot| try w.writeAll(switch (slot) {
+        .G2 => "\x1bN",
+        .G3 => "\x1bO",
+        else => unreachable,
+    });
+}
+pub fn literalCharset(state: T.Screen.CharsetState, w: *std.Io.Writer) !void {
+    // Preserve a UTF8 slot as UTF8; non-default slots can be restored explicitly.
+    if (state.charsets.get(.G0) != .utf8) try w.writeAll("\x1b(B");
+    try w.writeAll("\x0f");
+}
+pub fn margins(t: *const T.Terminal, w: *std.Io.Writer) !void {
+    const r = t.scrolling_region;
+    try w.print("\x1b[?69{s}\x1b[{d};{d}r", .{ if (t.modes.get(.enable_left_and_right_margin)) "h" else "l", r.top + 1, r.bottom + 1 });
+    if (t.modes.get(.enable_left_and_right_margin)) try w.print("\x1b[{d};{d}s", .{ r.left + 1, r.right + 1 });
+}
+fn writeCursorState(t: *const T.Terminal, s: *const T.Screen, x: u16, y: u16, pending: bool, origin: bool, pen: Style, protected: bool, cs: T.Screen.CharsetState, singles: bool, w: *std.Io.Writer) !void {
+    const left = if (origin) t.scrolling_region.left else 0;
+    const top = if (origin) t.scrolling_region.top else 0;
+    try w.print("\x1b[?6{s}\x1b[{d};{d}H", .{ if (origin) "h" else "l", y - top + 1, x - left + 1 });
+    if (pending) {
+        const pin = s.pages.pin(.{ .active = .{ .x = x, .y = y } }).?;
+        const rc = pin.rowAndCell();
+        const start = if (rc.cell.wide == .spacer_tail) x - 1 else x;
+        if (start != x) try w.print("\x1b[{d};{d}H", .{ y - top + 1, start - left + 1 });
+        try literalCharset(cs, w);
+        var cell: T.formatter.PageFormatter = .init(pin.node.page(), .{ .emit = .vt, .unwrap = false, .trim = false });
+        cell.start_x = start;
+        cell.end_x = x;
+        cell.start_y = pin.y;
+        cell.end_y = pin.y;
+        try cell.format(w);
+    }
+    try w.print("{f}", .{pen.formatterVt()});
+    // DECSCA resets active protection without resetting the historical mode.
+    if (s.protected_mode == .dec) try w.writeAll("\x1b[1\"q");
+    try w.writeAll(if (protected) "\x1b[1\"q" else "\x1b[0\"q");
+    try charset(cs, singles, w);
+}
+pub fn saved(t: *const T.Terminal, s: *const T.Screen, w: *std.Io.Writer) !void {
+    if (s.saved_cursor) |v| {
+        try writeCursorState(t, s, v.x, v.y, v.pending_wrap, v.origin, v.style, v.protected, v.charset, false, w);
+        try w.writeAll("\x1b7");
+    }
+}
+pub fn current(t: *const T.Terminal, s: *const T.Screen, origin: bool, singles: bool, w: *std.Io.Writer) !void {
+    try writeCursorState(t, s, s.cursor.x, s.cursor.y, s.cursor.pending_wrap, origin, s.cursor.style, s.cursor.protected, s.charset, singles, w);
+    if (s.cursor.hyperlink) |link| switch (link.id) {
+        .explicit => |id| try w.print("\x1b]8;id={s};{s}\x1b\\", .{ id, link.uri }),
+        .implicit => try w.print("\x1b]8;;{s}\x1b\\", .{link.uri}),
+    };
+    const shape: u8 = switch (s.cursor.cursor_style) {
+        .block => 1,
+        .underline => 3,
+        .bar => 5,
+        .block_hollow => 1,
+    };
+    try w.print("\x1b[{d} q", .{shape + @intFromBool(!t.modes.get(.cursor_blinking))});
+}
+pub fn keyboard(s: *const T.Screen, w: *std.Io.Writer) !void {
+    const stack = s.kitty_keyboard;
+    try w.writeAll("\x1b[<8u");
+    // Preserve every ring entry, not just current flags. Seven pushes position
+    // the same logical top; index rotation is not externally observable.
+    for (1..stack.flags.len + 1) |i| {
+        const index = (@as(usize, stack.idx) + i) % stack.flags.len;
+        if (i == 1) try w.print("\x1b[={d};1u", .{stack.flags[index].int()}) else try w.print("\x1b[>{d}u", .{stack.flags[index].int()});
+    }
+}
+pub fn dynamicColors(t: *const T.Terminal, w: *std.Io.Writer) !void {
+    for (t.colors.palette.current, 0..) |rgb, index| if (t.colors.palette.mask.isSet(index)) {
+        try w.print("\x1b]4;{d};rgb:{x:0>2}/{x:0>2}/{x:0>2}\x1b\\", .{ index, rgb.r, rgb.g, rgb.b });
+    };
+    inline for (.{ .{ 10, t.colors.foreground }, .{ 11, t.colors.background }, .{ 12, t.colors.cursor } }) |entry| {
+        if (entry[1].override) |rgb| try w.print("\x1b]{d};rgb:{x:0>2}/{x:0>2}/{x:0>2}\x1b\\", .{ entry[0], rgb.r, rgb.g, rgb.b });
+    }
+}
