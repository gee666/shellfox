+//! Shellfox additive ABI identity. Artifact authentication is external.
+const std = @import("std");
+const options = @import("terminal_options");
+pub const ansi_abi_version: u32 = 1;
+// The separately applied terminal-profile patch changes only this declaration.
+pub const terminal_profile_abi_version: u32 = 0;
+// The separately applied snapshot-budget patch changes only this declaration.
+pub const snapshot_budget_abi_version: u32 = 0;
+pub const engine_profile = options.shellfox_engine_profile;
+pub fn valid(value: []const u8) bool {
+    if (value.len != 64) return false;
+    for (value) |c| if (!((c >= '0' and c <= '9') or (c >= 'a' and c <= 'f'))) return false;
+    return true;
+}
+pub fn matches(value: []const u8) bool {
+    return valid(engine_profile) and std.mem.eql(u8, value, engine_profile);
+}
+test "Shellfox profile is a declared SHA256 identity, never authentication" {
+    const lower: [64]u8 = @splat('a');
+    const upper: [64]u8 = @splat('A');
+    try std.testing.expect(valid(&lower));
+    try std.testing.expect(!valid(&upper));
+    try std.testing.expect(!valid(""));
+}
