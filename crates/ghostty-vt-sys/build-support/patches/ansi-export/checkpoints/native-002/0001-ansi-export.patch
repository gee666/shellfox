+++ b/src/terminal/shellfox_ansi/main.zig
@@ -0,0 +1,93 @@
+//! Immutable ANSI reconstruction. No source parser, callbacks or viewport writes.
+const std = @import("std");
+const T = @import("types.zig");
+const modes = @import("modes.zig");
+const cursor = @import("cursor.zig");
+pub const Options = T.Options;
+pub const Reason = T.Reason;
+pub const Plan = T.Plan;
+pub const preflight = @import("preflight.zig").run;
+
+fn body(t: *const T.Terminal, s: *const T.Screen, w: *std.Io.Writer) !void {
+    try w.writeAll("\x1b[?6l\x1b[?69l\x1b[r\x1b[4l\x1b[?7h\x1b[H");
+    if (t.modes.get(.grapheme_cluster)) try w.writeAll("\x1b[?2027h");
+    var f: T.formatter.ScreenFormatter = .init(s, .{ .emit = .vt, .unwrap = false, .trim = false });
+    try f.format(w);
+}
+fn restore(t: *const T.Terminal, s: *const T.Screen, origin: bool, o: *const Options, w: *std.Io.Writer) !void {
+    try cursor.margins(t, w);
+    if (s.saved_cursor) |_| try cursor.saved(t, s, w);
+    if (o.target == 0 and o.target_features & 1 != 0) try cursor.keyboard(s, w);
+    try cursor.current(t, s, origin, false, w);
+}
+fn repairRep(t: *const T.Terminal, plan: Plan, w: *std.Io.Writer) !void {
+    const repair = plan.repair orelse return;
+    const s = t.screens.active;
+    try w.print("\x1b[?6l\x1b[{d};{d}H", .{ repair.y + 1, repair.x + 1 });
+    try cursor.literalCharset(s.charset, w);
+    if (repair.scratch) {
+        try w.writeAll("\x1b[0m\x1b[0\"q");
+        var bytes: [4]u8 = undefined;
+        const cp = t.previous_char.?;
+        const len = std.unicode.utf8Encode(cp, &bytes) catch return error.WriteFailed;
+        try w.writeAll(bytes[0..len]);
+        try w.print("\x1b[{d};{d}H\x1b[3X", .{ repair.y + 1, repair.x + 1 });
+    } else {
+        const pin = s.pages.pin(.{ .active = .{ .x = repair.x, .y = repair.y } }).?;
+        var cell: T.formatter.PageFormatter = .init(pin.node.page(), .{ .emit = .vt, .unwrap = false, .trim = false });
+        cell.start_x = repair.x;
+        cell.end_x = repair.x + @intFromBool(pin.rowAndCell().cell.wide == .wide);
+        cell.start_y = pin.y;
+        cell.end_y = pin.y;
+        try cell.format(w);
+    }
+}
+/// Called only after preflight succeeded. All unsupported-state checks precede
+/// this function, and the C wrapper counts into a bounded writer before copying.
+pub fn format(t: *const T.Terminal, o: *const Options, plan: Plan, continuation: []const u8, w: *std.Io.Writer) !void {
+    // RIS changes C-constructor policy, including shell redraw defaults.
+    // The accepted contract starts with a fresh configured target instead.
+    try w.writeAll("\x18");
+    if (t.flags.shell_redraws_prompt == .true) try w.writeAll("\x1b]133;A;redraw=1\x07\x1b]133;D\x07");
+    try modes.save(t, w);
+    try cursor.dynamicColors(t, w);
+    try w.print("\x1b]0;{s}\x1b\\\x1b]7;{s}\x1b\\", .{ t.getTitle() orelse "", t.getPwd() orelse "" });
+    // Tab stops are terminal-wide. Set them before content/cursor restoration.
+    try w.writeAll("\x1b[3g");
+    for (0..t.cols) |x| if (t.tabstops.get(x)) try w.print("\x1b[{d}G\x1bH", .{x + 1});
+    const primary = t.screens.get(.primary).?;
+    try body(t, primary, w);
+    if (t.screens.get(.alternate)) |alternate| {
+        if (t.screens.active_key == .alternate) {
+            const origin = if (t.modes.get(.alt_screen_save_cursor_clear_enter)) primary.saved_cursor.?.origin else false;
+            try restore(t, primary, origin, o, w);
+            if (t.modes.get(.alt_screen_save_cursor_clear_enter)) try modes.set(.alt_screen_save_cursor_clear_enter, true, w) else if (t.modes.get(.alt_screen)) try modes.set(.alt_screen, true, w) else try modes.set(.alt_screen_legacy, true, w);
+            if (t.modes.get(.save_cursor)) try modes.set(.save_cursor, true, w);
+            try body(t, alternate, w);
+            try restore(t, alternate, t.modes.get(.origin), o, w);
+        } else {
+            try modes.set(.alt_screen_legacy, true, w);
+            try body(t, alternate, w);
+            try restore(t, alternate, false, o, w);
+            try modes.set(.alt_screen_legacy, false, w);
+            if (t.modes.get(.save_cursor)) try modes.set(.save_cursor, true, w);
+            try restore(t, primary, t.modes.get(.origin), o, w);
+        }
+    } else {
+        if (t.modes.get(.save_cursor)) try modes.set(.save_cursor, true, w);
+        try restore(t, primary, t.modes.get(.origin), o, w);
+    }
+    try modes.current(t, w);
+    try cursor.margins(t, w);
+    try repairRep(t, plan, w);
+    try cursor.current(t, t.screens.active, t.modes.get(.origin), true, w);
+    if (t.cursor.is_default) try w.writeAll("\x1b[0 q");
+    // Nothing may follow this suffix before the next ordered live source byte.
+    try w.writeAll(continuation);
+}
+
+test {
+    _ = @import("legacy_width.zig");
+    _ = @import("../shellfox_unicode_v6_tests.zig");
+    _ = @import("tests.zig");
+}
diff --git a/src/terminal/shellfox_ansi/modes.zig b/src/terminal/shellfox_ansi/modes.zig
new file mode 100644
index 0000000..75f3848
--- /dev/null
+++ b/src/terminal/shellfox_ansi/modes.zig
@@ -0,0 +1,70 @@
+const std = @import("std");
+const T = @import("types.zig");
+pub fn set(mode: T.modes.Mode, value: bool, w: *std.Io.Writer) !void {
+    const tag: T.modes.ModeTag = @bitCast(@backingInt(mode));
+    try w.print("\x1b[{s}{d}{s}", .{ if (tag.ansi) "" else "?", tag.value, if (value) "h" else "l" });
+}
+fn excluded(mode: T.modes.Mode) bool {
+    return switch (mode) {
+        .@"132_column", .enable_mode_3, .in_band_size_reports, .report_color_scheme, .report_visibility, .kitty_paste_events => true,
+        else => false,
+    };
+}
+pub fn save(t: *const T.Terminal, w: *std.Io.Writer) !void {
+    const saved: T.modes.ModeState = .{ .values = t.modes.saved };
+    inline for (@typeInfo(T.modes.Mode).@"enum".field_values) |value| {
+        const mode: T.modes.Mode = @fromBackingInt(value);
+        const tag: T.modes.ModeTag = @bitCast(@backingInt(mode));
+        if (!tag.ansi and !excluded(mode)) {
+            if (mode == .save_cursor and saved.get(mode) and t.screens.get(.primary).?.saved_cursor == null)
+                try set(.alt_screen_legacy, true, w);
+            try set(mode, saved.get(mode), w);
+            try w.print("\x1b[?{d}s", .{tag.value});
+        }
+    }
+    // Return to the reset mode baseline WITHOUT resetting the saved-mode bank.
+    const defaults: T.modes.ModeState = .{};
+    inline for (@typeInfo(T.modes.Mode).@"enum".field_values) |value| {
+        const mode: T.modes.Mode = @fromBackingInt(value);
+        if (!excluded(mode)) try set(mode, defaults.get(mode), w);
+    }
+}
+pub fn current(t: *const T.Terminal, w: *std.Io.Writer) !void {
+    inline for (@typeInfo(T.modes.Mode).@"enum".field_values) |value| {
+        const mode: T.modes.Mode = @fromBackingInt(value);
+        if (!T.transition(mode) and !excluded(mode)) try set(mode, t.modes.get(mode), w);
+    }
+    // Event/format precedence is independent of the mode bitset. Re-enable
+    // the effective mode last, or disable an already-false mode for defaults.
+    const event = switch (t.flags.mouse_event) {
+        .none => null,
+        .x10 => T.modes.Mode.mouse_event_x10,
+        .normal => .mouse_event_normal,
+        .button => .mouse_event_button,
+        .any => .mouse_event_any,
+    };
+    if (event) |mode| try set(mode, true, w) else {
+        for ([_]T.modes.Mode{ .mouse_event_x10, .mouse_event_normal, .mouse_event_button, .mouse_event_any }) |mode| {
+            if (!t.modes.get(mode)) {
+                try set(mode, false, w);
+                break;
+            }
+        }
+    }
+    const format = switch (t.flags.mouse_format) {
+        .x10 => null,
+        .utf8 => T.modes.Mode.mouse_format_utf8,
+        .sgr => .mouse_format_sgr,
+        .urxvt => .mouse_format_urxvt,
+        .sgr_pixels => .mouse_format_sgr_pixels,
+    };
+    if (format) |mode| try set(mode, true, w) else {
+        for ([_]T.modes.Mode{ .mouse_format_utf8, .mouse_format_sgr, .mouse_format_urxvt, .mouse_format_sgr_pixels }) |mode| {
+            if (!t.modes.get(mode)) {
+                try set(mode, false, w);
+                break;
+            }
+        }
+    }
+    try w.print("\x1b[>4;{d}m", .{@as(u8, if (t.flags.modify_other_keys_2) 2 else 0)});
+}
diff --git a/src/terminal/shellfox_ansi/preflight.zig b/src/terminal/shellfox_ansi/preflight.zig
new file mode 100644
index 0000000..d74e0cb
--- /dev/null
+++ b/src/terminal/shellfox_ansi/preflight.zig
@@ -0,0 +1,207 @@
+const std = @import("std");
+const T = @import("types.zig");
+const width = @import("legacy_width.zig");
+const color = @import("../color.zig");
+const build = @import("terminal_options");
+const charsets = @import("../charsets.zig");
+pub const Error = error{LimitExceeded};
+fn effectiveMouseValid(t: *const T.Terminal) bool {
+    const event: ?T.modes.Mode = switch (t.flags.mouse_event) {
+        .none => null,
+        .x10 => .mouse_event_x10,
+        .normal => .mouse_event_normal,
+        .button => .mouse_event_button,
+        .any => .mouse_event_any,
+    };
+    if (event) |mode| {
+        if (!t.modes.get(mode)) return false;
+    } else {
+        var off = false;
+        for ([_]T.modes.Mode{ .mouse_event_x10, .mouse_event_normal, .mouse_event_button, .mouse_event_any }) |mode| off = off or !t.modes.get(mode);
+        if (!off) return false;
+    }
+    const format: ?T.modes.Mode = switch (t.flags.mouse_format) {
+        .x10 => null,
+        .utf8 => .mouse_format_utf8,
+        .sgr => .mouse_format_sgr,
+        .urxvt => .mouse_format_urxvt,
+        .sgr_pixels => .mouse_format_sgr_pixels,
+    };
+    if (format) |mode| {
+        if (!t.modes.get(mode)) return false;
+    } else {
+        var off = false;
+        for ([_]T.modes.Mode{ .mouse_format_utf8, .mouse_format_sgr, .mouse_format_urxvt, .mouse_format_sgr_pixels }) |mode| off = off or !t.modes.get(mode);
+        if (!off) return false;
+    }
+    return true;
+}
+
+pub fn run(t: *const T.Terminal, o: *const T.Options) Error!T.Plan {
+    var plan: T.Plan = .{};
+    if (o.target_is_fresh != 1) plan.unsupported |= T.Reason.defaults;
+    if (!effectiveMouseValid(t)) plan.unsupported |= T.Reason.modes;
+    const state_bridge = @import("profile_state.zig");
+    if (state_bridge.terminal_profile_abi_version != T.profile.terminal_profile_abi_version)
+        plan.unsupported |= T.Reason.profile;
+    plan.unsupported |= state_bridge.check(t, o);
+    // Legacy final join-state reproduction remains a separate acceptance gate.
+    if (o.target == 1) plan.unsupported |= T.Reason.profile;
+    if (!T.profile.matches(o.engine_profile.ptr[0..o.engine_profile.len])) plan.unsupported |= T.Reason.profile;
+    if (!std.meta.eql(t.modes.default, T.modes.ModePacked{}) or
+        !T.equalRgb(t.colors.foreground.default, o.default_foreground) or
+        !T.equalRgb(t.colors.background.default, o.default_background) or
+        !T.equalRgb(t.colors.cursor.default, o.default_cursor) or
+        @backingInt(t.cursor.default_style) != o.default_cursor_style or
+        (if (t.cursor.default_blink) |b| @as(i32, @intFromBool(b)) else -1) != o.default_cursor_blink or
+        t.flags.resize_pull_scrollback != (o.runtime_resize_pull_scrollback != 0)) plan.unsupported |= T.Reason.defaults;
+    const primary = t.screens.get(.primary).?;
+    if (primary.pages.limits.bytes.explicit != o.target_scrollback_max_bytes or
+        primary.pages.limits.lines.explicit != o.target_scrollback_max_rows) plan.unsupported |= T.Reason.defaults;
+    const palette: []const color.RGB = if (o.default_palette) |p| p[0..256] else &color.default;
+    if (!std.mem.eql(color.RGB, t.colors.palette.original, palette)) plan.unsupported |= T.Reason.defaults;
+    if (!T.safeOsc(t.getPwd() orelse "") or !T.safeOsc(t.getTitle() orelse "")) plan.unsupported |= T.Reason.metadata;
+    if (t.glyph_glossary.entries.count() != 0 or t.kitty_dnd != null) plan.unsupported |= T.Reason.graphics;
+    if (t.status_display != .main or t.mouse_shape != .text or t.flags.password_input or t.flags.mouse_shift_capture != .null or
+        !std.meta.eql(t.default_xt_checksum, @import("../xt_checksum.zig").Flags{}) or
+        !std.meta.eql(t.flags.xt_checksum, t.default_xt_checksum)) plan.unsupported |= T.Reason.semantics;
+    const state: T.modes.ModeState = .{ .values = t.modes.saved };
+    const reset: T.modes.ModeState = .{};
+    inline for (@typeInfo(T.modes.Mode).@"enum".field_values) |v| {
+        const mode: T.modes.Mode = @fromBackingInt(v);
+        const tag: T.modes.ModeTag = @bitCast(@backingInt(mode));
+        if (tag.ansi and state.get(mode) != reset.get(mode)) plan.unsupported |= T.Reason.modes;
+    }
+    if (t.modes.get(.save_cursor) and t.screens.active.saved_cursor == null) plan.unsupported |= T.Reason.cursor;
+    if (t.screens.get(.primary).?.saved_cursor == null and state.get(.alt_screen_save_cursor_clear_enter)) plan.unsupported |= T.Reason.cursor;
+    if (state.get(.save_cursor) and t.screens.get(.primary).?.saved_cursor == null and
+        (t.screens.get(.alternate) == null or t.screens.get(.alternate).?.saved_cursor == null)) plan.unsupported |= T.Reason.cursor;
+    for ([_]T.modes.Mode{ .@"132_column", .enable_mode_3, .in_band_size_reports, .report_color_scheme, .report_visibility, .kitty_paste_events }) |mode| {
+        if (t.modes.get(mode) or state.get(mode)) plan.unsupported |= T.Reason.modes;
+    }
+    if (o.target == 1 and (t.modes.get(.grapheme_cluster) or state.get(.grapheme_cluster))) plan.unsupported |= T.Reason.width;
+    const alt = t.screens.active_key == .alternate;
+    const transitions = @as(u3, @intFromBool(t.modes.get(.alt_screen_legacy))) +
+        @as(u3, @intFromBool(t.modes.get(.alt_screen))) + @as(u3, @intFromBool(t.modes.get(.alt_screen_save_cursor_clear_enter)));
+    if ((!alt and transitions != 0) or (alt and transitions != 1)) plan.unsupported |= T.Reason.modes;
+    if (t.screens.get(.alternate) == null and (state.get(.alt_screen_legacy) or state.get(.alt_screen) or
+        state.get(.alt_screen_save_cursor_clear_enter))) plan.unsupported |= T.Reason.modes;
+    if (alt and t.modes.get(.alt_screen_save_cursor_clear_enter)) {
+        const p = t.screens.get(.primary).?;
+        const saved = p.saved_cursor orelse {
+            plan.unsupported |= T.Reason.cursor;
+            return plan;
+        };
+        if (saved.x != p.cursor.x or saved.y != p.cursor.y or saved.pending_wrap != p.cursor.pending_wrap or
+            saved.protected != p.cursor.protected or !std.meta.eql(saved.style, p.cursor.style) or
+            !std.meta.eql(saved.charset, p.charset)) plan.unsupported |= T.Reason.cursor;
+    }
+    var any_nonempty = false;
+    var rows: usize = 0;
+    var cells: usize = 0;
+    var screen_map = t.screens.all;
+    var screens = screen_map.iterator();
+    while (screens.next()) |entry| {
+        const s = entry.value.*;
+        rows = std.math.add(usize, rows, s.pages.total_rows) catch return error.LimitExceeded;
+        const n = std.math.mul(usize, s.pages.total_rows, t.cols) catch return error.LimitExceeded;
+        cells = std.math.add(usize, cells, n) catch return error.LimitExceeded;
+        if (rows > o.max_rows or cells > o.max_cells) return error.LimitExceeded;
+        if (comptime build.kitty_graphics) {
+            if (s.kitty_images.total_limit != o.runtime_image_storage_limit or s.kitty_images.image_limits.file or
+                s.kitty_images.image_limits.shared_memory or s.kitty_images.image_limits.temporary_file != .disabled)
+                plan.unsupported |= T.Reason.graphics;
+            if (s.kitty_images.images.count() != 0 or s.kitty_images.placements.count() != 0) plan.unsupported |= T.Reason.graphics;
+        }
+        if (s.cursor.cursor_style == .block_hollow) plan.unsupported |= T.Reason.cursor;
+        if (entry.key == .alternate and s.pages.total_rows != t.rows) plan.unsupported |= T.Reason.cursor;
+        if (!std.meta.eql(s.semantic_prompt, T.Screen.SemanticPrompt.disabled)) plan.unsupported |= T.Reason.semantics;
+        if (s.charset.single_shift) |slot| if (slot != .G2 and slot != .G3) {
+            plan.unsupported |= T.Reason.charsets;
+        };
+        if (s.cursor.semantic_content != .output or s.cursor.semantic_content_clear_eol or s.protected_mode == .iso)
+            plan.unsupported |= T.Reason.semantics;
+        if (s.cursor.hyperlink) |link| if (!T.safeOsc(link.uri) or switch (link.id) {
+            .explicit => |id| !T.safeOsc(id),
+            .implicit => false,
+        }) {
+            plan.unsupported |= T.Reason.metadata;
+        };
+        if (entry.key != t.screens.active_key and s.cursor.hyperlink != null) plan.unsupported |= T.Reason.cursor;
+        if (o.target == 1 or o.target_features & 1 == 0) {
+            for (s.kitty_keyboard.flags) |flags| if (flags.int() != 0) {
+                plan.unsupported |= T.Reason.keyboard;
+            };
+        }
+        if (s.saved_cursor) |saved| {
+            if (saved.charset.single_shift != null or saved.charset.gr == .G0) plan.unsupported |= T.Reason.charsets;
+            if (saved.origin and (saved.x < t.scrolling_region.left or saved.x > t.scrolling_region.right or
+                saved.y < t.scrolling_region.top or saved.y > t.scrolling_region.bottom)) plan.unsupported |= T.Reason.cursor;
+            if (saved.pending_wrap and saved.x != (if (saved.x > t.scrolling_region.right) t.cols - 1 else t.scrolling_region.right))
+                plan.unsupported |= T.Reason.cursor;
+            for (std.enums.values(charsets.Slots)) |slot| {
+                if (saved.charset.charsets.get(slot) != .utf8 and s.charset.charsets.get(slot) == .utf8)
+                    plan.unsupported |= T.Reason.charsets;
+            }
+            if (saved.pending_wrap and !s.pages.pin(.{ .active = .{ .x = saved.x, .y = saved.y } }).?.rowAndCell().cell.hasText())
+                plan.unsupported |= T.Reason.cursor;
+        }
+        if (entry.key == t.screens.active_key and t.modes.get(.origin) and (s.cursor.x < t.scrolling_region.left or s.cursor.x > t.scrolling_region.right or
+            s.cursor.y < t.scrolling_region.top or s.cursor.y > t.scrolling_region.bottom)) plan.unsupported |= T.Reason.cursor;
+        if (s.cursor.pending_wrap and s.cursor.x != (if (s.cursor.x > t.scrolling_region.right) t.cols - 1 else t.scrolling_region.right))
+            plan.unsupported |= T.Reason.cursor;
+        if (s.cursor.pending_wrap and !s.cursor.page_cell.hasText() and s.cursor.page_cell.wide != .spacer_tail)
+            plan.unsupported |= T.Reason.cursor;
+        if (s.charset.gr == .G0) plan.unsupported |= T.Reason.charsets;
+        var pages = s.pages.getTopLeft(.screen).pageIterator(.right_down, s.pages.getBottomRight(.screen).?);
+        while (pages.next()) |chunk| {
+            const p = chunk.node.page();
+            if (p.size.cols != t.cols) plan.unsupported |= T.Reason.width;
+            for (chunk.start..chunk.end) |y| {
+                const row = p.getRow(y);
+                if (row.kitty_virtual_placeholder) plan.unsupported |= T.Reason.graphics;
+                for (p.getCells(row)) |*cell| {
+                    any_nonempty = any_nonempty or !cell.isEmpty();
+                    if (cell.hasText()) {
+                        const cp = cell.codepoint();
+                        if (cp > 0x10ffff or (cp >= 0xd800 and cp <= 0xdfff)) plan.unsupported |= T.Reason.width;
+                        if (p.lookupGrapheme(cell)) |extra| for (extra) |item| {
+                            if (item > 0x10ffff or (item >= 0xd800 and item <= 0xdfff)) plan.unsupported |= T.Reason.width;
+                        };
+                    }
+                    if (cell.semantic_content != .output or cell.protected) plan.unsupported |= T.Reason.semantics;
+                    // Cell URI replay is intentionally not lossy or guessed safe.
+                    if (cell.hyperlink) plan.unsupported |= T.Reason.metadata;
+                    if (o.target == 1 and cell.hasText()) {
+                        const actual: u2 = if (cell.wide == .wide) 2 else 1;
+                        if (width.clusterWidth(cell.codepoint(), p.lookupGrapheme(cell) orelse &.{}) != actual)
+                            plan.unsupported |= T.Reason.width;
+                    }
+                }
+            }
+        }
+    }
+    const s = t.screens.active;
+    // A pending-wrap cursor reprints its cell last, establishing REP itself.
+    if (s.cursor.pending_wrap) {
+        const c = if (s.cursor.page_cell.wide == .spacer_tail) s.cursorCellLeft(1) else s.cursor.page_cell;
+        if (t.previous_char != c.codepoint()) plan.unsupported |= T.Reason.rep;
+    } else if (t.previous_char) |previous| {
+        var scratch: ?T.Repair = null;
+        for (0..t.rows) |y| for (0..t.cols) |x| {
+            const pin = s.pages.pin(.{ .active = .{ .x = @intCast(x), .y = @intCast(y) } }).?;
+            const rc = pin.rowAndCell();
+            if (x + 3 < t.cols and rc.cell.isEmpty() and
+                pin.right(1).rowAndCell().cell.isEmpty() and pin.right(2).rowAndCell().cell.isEmpty())
+                scratch = .{ .x = @intCast(x), .y = @intCast(y), .scratch = true };
+            if (rc.cell.hasText() and rc.cell.codepoint() == previous and x + 2 < t.cols and rc.cell.wide != .spacer_tail)
+                plan.repair = .{ .x = @intCast(x), .y = @intCast(y), .scratch = false };
+        };
+        if (plan.repair == null) plan.repair = scratch;
+        if (plan.repair == null) plan.unsupported |= T.Reason.rep;
+    } else {
+        // A populated screen with no REP register is not ANSI-reconstructible.
+        if (any_nonempty) plan.unsupported |= T.Reason.rep;
+    }
+    return plan;
+}
diff --git a/src/terminal/shellfox_ansi/profile_state.zig b/src/terminal/shellfox_ansi/profile_state.zig
new file mode 100644
