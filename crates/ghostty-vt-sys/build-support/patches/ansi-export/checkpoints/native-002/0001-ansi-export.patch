+//! Patch-1 prerequisite: original terminals are Native by construction.
+//! Patch 2 must replace this check with its sole checked capture() routine.
+const T = @import("types.zig");
+pub const terminal_profile_abi_version: u32 = 0;
+pub fn check(t: *const T.Terminal, options: *const T.Options) u64 {
+    _ = t;
+    return if (options.target == 0) 0 else T.Reason.profile;
+}
