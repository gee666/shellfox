+const std = @import("std");
+const lib = @import("../lib.zig");
+const color = @import("../color.zig");
+pub const Terminal = @import("../Terminal.zig");
+pub const Screen = @import("../Screen.zig");
+pub const formatter = @import("../formatter.zig");
+pub const modes = @import("../modes.zig");
+pub const profile = @import("../shellfox_profile.zig");
+pub const max_output = 64 * 1024 * 1024;
+pub const Reason = struct {
+    pub const profile: u64 = 1 << 0;
+    pub const defaults: u64 = 1 << 1;
+    pub const graphics: u64 = 1 << 2;
+    pub const metadata: u64 = 1 << 3;
+    pub const modes: u64 = 1 << 4;
+    pub const charsets: u64 = 1 << 5;
+    pub const keyboard: u64 = 1 << 6;
+    pub const cursor: u64 = 1 << 7;
+    pub const rep: u64 = 1 << 8;
+    pub const semantics: u64 = 1 << 9;
+    pub const width: u64 = 1 << 10;
+    pub const continuation: u64 = 1 << 11;
+    pub const source_error: u64 = 1 << 12;
+};
+pub const Options = extern struct {
+    size: usize = @sizeOf(Options),
+    abi_version: u32 = 1,
+    target: u32 = 0,
+    target_features: u64 = 0,
+    engine_profile: lib.String = .init(@as([]const u8, "")),
+    max_output_bytes: usize = 16 * 1024 * 1024,
+    max_rows: usize = 65536,
+    max_cells: usize = 1024 * 1024,
+    max_continuation_bytes: usize = 65536,
+    default_foreground: ?*const color.RGB = null,
+    default_background: ?*const color.RGB = null,
+    default_cursor: ?*const color.RGB = null,
+    default_palette: ?[*]const color.RGB = null,
+    default_cursor_style: u32 = 1,
+    default_cursor_blink: i32 = 0,
+    runtime_resize_pull_scrollback: u32 = 1,
+    target_is_fresh: u8 = 1,
+    target_scrollback_max_bytes: usize = 0,
+    target_scrollback_max_rows: usize = 0,
+    runtime_image_storage_limit: u64 = 0,
+
+    pub fn valid(self: *const Options) bool {
+        if (self.size != @sizeOf(Options)) return false;
+        return self.abi_version == 1 and self.engine_profile.len <= 64 and self.target <= 1 and self.target_features & ~@as(u64, 1) == 0 and
+            self.max_output_bytes <= max_output and self.max_rows > 0 and self.max_rows <= 1024 * 1024 and
+            self.max_cells > 0 and self.max_cells <= 16 * 1024 * 1024 and self.max_continuation_bytes <= 65536 and
+            self.default_cursor_style <= 3 and self.default_cursor_blink >= -1 and self.default_cursor_blink <= 1 and
+            self.runtime_resize_pull_scrollback <= 1 and self.target_is_fresh <= 1;
+    }
+};
+pub const Repair = struct { x: u16, y: u16, scratch: bool };
+pub const Plan = struct { unsupported: u64 = 0, repair: ?Repair = null };
+pub fn safeOsc(value: []const u8) bool {
+    if (!std.unicode.utf8ValidateSlice(value)) return false;
+    for (value) |c| if (c < 0x20 or c == 0x7f or c == 0x9c) return false;
+    return true;
+}
+pub fn equalRgb(actual: ?color.RGB, declared: ?*const color.RGB) bool {
+    return std.meta.eql(actual, if (declared) |v| v.* else null);
+}
+pub fn transition(mode: modes.Mode) bool {
+    return switch (mode) {
+        .alt_screen_legacy, .alt_screen, .alt_screen_save_cursor_clear_enter, .save_cursor => true,
+        else => false,
+    };
+}
