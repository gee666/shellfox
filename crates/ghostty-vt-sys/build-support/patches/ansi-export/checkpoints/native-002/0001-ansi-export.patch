+//! Exhaustive differential fingerprints from the pinned shipped JS provider.
+const std = @import("std");
+const width = @import("shellfox_unicode_v6.zig");
+fn digest(state: ?u32) [64]u8 {
+    var hash: std.crypto.hash.sha2.Sha256 = .init(.{});
+    var bytes: [4096]u8 = undefined;
+    var start: usize = 0;
+    while (start < 0x110000) : (start += bytes.len) {
+        const n = @min(bytes.len, 0x110000 - start);
+        for (bytes[0..n], start..) |*byte, cp| {
+            byte.* = @intCast(if (state) |value| width.properties(@intCast(cp), value).? else width.width(@intCast(cp)));
+        }
+        hash.update(bytes[0..n]);
+    }
+    var result: [32]u8 = undefined;
+    hash.final(&result);
+    return std.fmt.bytesToHex(result, .lower);
+}
