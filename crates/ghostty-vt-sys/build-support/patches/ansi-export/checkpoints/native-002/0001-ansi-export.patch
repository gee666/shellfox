+test "Shellfox full ANSI preserves saved mode bank, charsets and keyboard stack" {
+    try roundtrip("\x1b[?1h\x1b[?1s\x1b[?1l\x1b[>1u\x1b[>3u\x1b[>7u\x1b(0q\x1b7\x1b(Bx", "\x1b[?1r\x1b[<u\x1b8q");
+}
+test "Shellfox full ANSI handles reset policy and exact color override state on fresh targets" {
+    try roundtrip("\x1bcafter", "\x1b]133;A\x07prompt");
+    try roundtrip("\x1b]4;42;rgb:12/34/56\x07\x1b]10;rgb:ab/cd/ef\x07\x1b]0;title\x07\x1b]7;file:///tmp/fixture\x07text", "\x1b]104;42\x07\x1b]110\x07!");
+}
+test "Shellfox full ANSI preserves G1, origin margins, and nonblank pending wide wrap" {
+    try roundtrip("\x1b[2;4r\x1b[?6h\x1b[1;1H\x1b)0\x0eq\x1b7\x0f\x1b[?6l\x1b[5;1Hx", "\x1b8q");
+    try roundtrip("\x1b[2;2H\x1b7\x1b[5;1H123456789012345678界", "X\x1b8Y");
+}
+test "Shellfox full ANSI preserves effective mouse precedence, not just mode bits" {
+    try roundtrip("x\x1b[?1003h\x1b[?1000h\x1b[?1006h\x1b[?1005h", "y");
+    try roundtrip("x\x1b[?1000h\x1b[?1003h\x1b[?1003l", "y");
+}
+test "Shellfox full ANSI requires exact resize policy and preserves false and true resize suffixes" {
+    for ([_]bool{ false, true }) |pull| {
+        const source = try new();
+        defer term.free(source);
+        const target = try new();
+        defer term.free(target);
+        try testing.expectEqual(Result.success, term.set(source, .resize_pull_scrollback, &pull));
+        try testing.expectEqual(Result.success, term.set(target, .resize_pull_scrollback, &pull));
+        write(source, "one\r\ntwo\r\nthree\r\nfour\r\nfive\r\nsix\r\nseven");
+        var opts = options(source);
+        opts.runtime_resize_pull_scrollback = @intFromBool(!pull);
+        var byte: [1]u8 = .{0xa5};
+        var n: usize = 1;
+        var reason: u64 = 0;
+        try testing.expectEqual(Result.unsupported, api.export_buf(source, &opts, &byte, byte.len, &n, &reason));
+        try testing.expect(reason & T.Reason.defaults != 0);
+        try testing.expectEqual(@as(u8, 0xa5), byte[0]);
+        const bytes = try exportOwned(source);
+        defer testing.allocator.free(bytes);
+        write(target, bytes);
+        try same(source, target);
+        try testing.expectEqual(Result.success, term.resize(source, 20, 8, 0, 0));
+        try testing.expectEqual(Result.success, term.resize(target, 20, 8, 0, 0));
+        write(source, "\r\nafter");
+        write(target, "\r\nafter");
+        try same(source, target);
+    }
+}
