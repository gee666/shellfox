+//! Additive, atomic, callback-free bounded snapshot decoder.
+const std = @import("std");
+const builtin = @import("builtin");
+const lib = @import("../lib.zig");
+const options_build = @import("terminal_options");
+const Result = @import("result.zig").Result;
+const terminal_c = @import("terminal.zig");
+const snapshot = @import("../snapshot/main.zig");
+const preflight = @import("../snapshot/budget_preflight.zig");
+const guard = @import("../snapshot_budget_guard.zig");
+const profile = @import("../shellfox_terminal_profile.zig");
+const identity = @import("../shellfox_profile.zig");
+
+pub const supported_build = lib.feature(.snapshot) and !options_build.slow_runtime_safety and switch (builtin.os.tag) {
+    .windows, .linux, .macos, .ios => true,
+    else => false,
+};
+
+pub const Options = extern struct {
+    size: usize = @sizeOf(Options),
+    abi_version: u32 = 1,
+    profile: u32 = 1,
+    ghostty_version: u32 = 0x00010001,
+    snapshot_version: u32 = 1,
+    engine_profile: lib.String,
+    profile_state: profile.State,
+    flags: u32 = 0,
+    reserved: u32 = 0,
+    max_encoded_bytes: u64,
+    max_allocation_bytes: u64,
+    max_work_units: u64,
+    max_cells: u64,
+    max_history_rows: u64,
+    max_continuation_bytes: u64,
+    max_image_bytes: u64 = 0,
+    max_decompressed_bytes: u64 = 0,
+    runtime_image_storage_limit: u64,
+    runtime_image_io_policy: u32 = 0,
+    runtime_resize_pull_scrollback: u32,
+    max_columns: u32,
+    max_rows: u32,
+    max_pixel_width: u32,
+    max_pixel_height: u32,
+    max_page_rows: u32,
+    max_pages: u32,
+    max_records: u32,
+    max_images: u32 = 0,
+};
+
+pub const Report = extern struct {
+    size: usize = @sizeOf(Report),
+    abi_version: u32 = 1,
+    reserved: u32 = 0,
+    source_offset: u64 = 0,
+    heap_bytes: u64 = 0,
+    mapped_bytes: u64 = 0,
+    work_units: u64 = 0,
+};
+
+pub fn decode_buf(
+    ptr: ?[*]const u8,
+    len: usize,
+    options_: ?*const Options,
+    out_: ?*terminal_c.Terminal,
+    report: ?*Report,
+) callconv(lib.calling_conv) Result {
+    const out = out_ orelse return .invalid_value;
+    out.* = null;
+    if (comptime !supported_build) return .unsupported;
+    // Check size before touching any later member of caller-owned structs.
+    const options_ptr = options_ orelse return .invalid_value;
+    if (options_ptr.size != @sizeOf(Options)) return .invalid_value;
+    const options = options_ptr.*;
+    if (report) |r| {
+        if (r.size != @sizeOf(Report)) return .invalid_value;
+        if (r.abi_version != 1 or r.reserved != 0) return .unsupported;
+        r.* = .{};
+    }
+    const compatible = validateCommon(options);
+    if (compatible != .success) return compatible;
+    // Raw-v1 cannot represent the new Legacy cell layout.
+    if (options.profile_state.terminal_profile != profile.Native) return .unsupported;
+    profile.validateState(&options.profile_state, options.profile_state.terminal_profile) catch |err|
+        return mapError(err, false);
+    const runtime_image_limit = std.math.cast(usize, options.runtime_image_storage_limit) orelse
+        return .unsupported;
+    if (comptime !options_build.kitty_graphics) {
+        if (runtime_image_limit != 0) return .unsupported;
+    }
+    const bytes: []const u8 = if (ptr) |p| p[0..len] else if (len == 0) &.{} else return .invalid_value;
+    if (len > options.max_encoded_bytes) return .limit_exceeded;
+    var scope: guard.Scope = .{
+        .max_bytes = options.max_allocation_bytes,
+        .max_work = options.max_work_units,
+    };
+    if (!guard.enter(&scope)) return .unsupported;
+    defer guard.leave();
+    var offset: u64 = 0;
+    defer if (report) |r| {
+        r.source_offset = offset;
+        r.heap_bytes = scope.heap_bytes;
+        r.mapped_bytes = scope.mapped_bytes;
+        r.work_units = scope.work;
+    };
+    preflight.check(bytes, options, &scope, &offset) catch |err| return mapError(err, scope.exceeded);
+    const alloc = guard.heapAllocator();
+    const io: terminal_c.Io = .init;
+    var source: std.Io.Reader = .fixed(bytes);
+    var decoder: snapshot.Decoder = .init(&source);
+    defer offset = source.seek;
+    var decoded = decoder.ready(alloc, io.io(), .{
+        .max_continuation_bytes = std.math.cast(usize, options.max_continuation_bytes) orelse
+            return .unsupported,
+        .compress_history = false,
+        .kitty_image_storage_limit = runtime_image_limit,
+    }) catch |err| return mapError(err, scope.exceeded);
+    defer decoded.deinit(alloc);
+    if (scope.failed()) return mapError(error.OutOfMemory, scope.exceeded);
+    const native = &decoded.terminal.?;
+    while (decoder.next(alloc, native) catch |err| return mapError(err, scope.exceeded)) |progress| {
+        if (scope.failed()) return mapError(error.OutOfMemory, scope.exceeded);
+        switch (progress) {
+            .page => |p| if (p.rows == 0) return .invalid_value,
+            .image => return .unsupported,
+        }
+    }
+    if (source.seek != bytes.len) return .invalid_value;
+    // The upstream metadata is advisory. This API requires exact agreement,
+    // including history already resident in the first SCREEN page.
+    var it = native.screens.all.iterator();
+    while (it.next()) |entry| {
+        const pages = &entry.value.*.pages;
+        const expected = decoded.history_rows.get(entry.key) orelse return .invalid_value;
+        if (pages.total_rows < native.rows or pages.total_rows - native.rows != expected)
+            return .invalid_value;
+    }
+    native.flags.resize_pull_scrollback = options.runtime_resize_pull_scrollback == 1;
+    scope.chargeWork(options.max_cells) catch return .limit_exceeded;
+    profile.restoreStateBeforeContinuation(
+        native,
+        options.profile_state.terminal_profile,
+        &options.profile_state,
+        std.math.cast(usize, options.max_cells) orelse return .unsupported,
+    ) catch |err| return mapError(err, scope.exceeded);
+    const terminal = terminal_c.fromDecoded(
+        alloc,
+        io,
+        &decoded,
+        std.math.cast(usize, options.max_continuation_bytes) orelse return .unsupported,
+    ) catch |err| return mapError(err, scope.exceeded);
+    // Some upstream optional allocations recover from OOM. A refused charge
+    // must never turn into a successful, possibly degraded snapshot restore.
+    if (scope.failed()) {
+        terminal_c.free(terminal);
+        return mapError(error.OutOfMemory, scope.exceeded);
+    }
+    if (!terminal_c.budgetRawV1ConfigSupported(terminal)) {
+        terminal_c.free(terminal);
+        return .unsupported;
+    }
+    const restored_state = profile.capture(terminal_c.zigTerminal(terminal).?) catch |err| {
+        terminal_c.free(terminal);
+        return mapError(err, scope.exceeded);
+    };
+    if (restored_state.terminal_profile != options.profile_state.terminal_profile or
+        restored_state.preceding_join != options.profile_state.preceding_join)
+    {
+        terminal_c.free(terminal);
+        return .invalid_value;
+    }
+    out.* = terminal;
+    return .success;
+}
+
+pub fn validateCommon(options: anytype) Result {
+    if (identity.snapshot_budget_abi_version != 1 or identity.terminal_profile_abi_version != profile.abi_version)
+        return .unsupported;
+    if (options.abi_version != 1 or options.profile != 1 or
+        options.ghostty_version != 0x00010001 or options.snapshot_version != 1 or
+        options.flags != 0 or options.reserved != 0 or options.max_images != 0 or
+        options.max_image_bytes != 0 or options.max_decompressed_bytes != 0 or
+        options.runtime_image_io_policy != 0 or options.runtime_resize_pull_scrollback > 1)
+        return .unsupported;
+    if (options.engine_profile.len != 64 or @intFromPtr(options.engine_profile.ptr) == 0)
+        return .unsupported;
+    if (!identity.matches(options.engine_profile.ptr[0..64])) return .unsupported;
+    // Slow integrity verification and unverified mapping backends are outside
+    // this admitted work/allocation profile.
+    if (comptime !supported_build) return .unsupported;
+    return .success;
+}
+
+pub fn mapError(err: anyerror, exceeded: bool) Result {
+    if (exceeded) return .limit_exceeded;
+    return switch (err) {
+        error.OutOfMemory => .out_of_memory,
+        error.OutOfSpace => .out_of_space,
+        error.LimitExceeded, error.ContinuationLimitExceeded => .limit_exceeded,
+        error.UnsupportedProfile, error.UnsupportedVersion => .unsupported,
+        else => .invalid_value,
+    };
+}
+
+test "snapshot budget unsupported builds refuse both atomic APIs" {
+    if (comptime supported_build) return error.SkipZigTest;
+    var out: terminal_c.Terminal = null;
+    try std.testing.expectEqual(Result.unsupported, decode_buf(null, 0, null, &out, null));
+    try std.testing.expectEqual(@as(terminal_c.Terminal, null), out);
+    var state: profile.State = .{ .terminal_profile = 0, .preceding_join = 0 };
+    var written: usize = 99;
+    try std.testing.expectEqual(Result.unsupported, @import("shellfox_snapshot_budget_encode.zig").encode_buf(
+        null,
+        null,
+        null,
+        0,
+        &written,
+        &state,
+        null,
+    ));
+    try std.testing.expectEqual(@as(usize, 0), written);
+    try std.testing.expectEqual(@as(usize, 0), state.size);
+}
+
+test {
+    if (!options_build.slow_runtime_safety and lib.feature(.snapshot)) {
+        _ = @import("snapshot_budget_tests.zig");
+        _ = @import("snapshot_budget_adversarial_tests.zig");
+    }
+}
