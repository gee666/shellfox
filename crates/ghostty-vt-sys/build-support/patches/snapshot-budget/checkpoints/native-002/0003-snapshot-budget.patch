+
+pub fn decode(bytes: []const u8, options: budget.Options, expected: Result) !budget.Report {
+    var out: terminal.Terminal = null;
+    var report: budget.Report = .{};
+    try testing.expectEqual(expected, budget.decode_buf(bytes.ptr, bytes.len, &options, &out, &report));
+    defer terminal.free(out);
+    try testing.expectEqual(expected == .success, out != null);
+    try testing.expect(report.heap_bytes + report.mapped_bytes <= options.max_allocation_bytes);
+    try testing.expect(report.work_units <= options.max_work_units);
+    return report;
+}
+
+pub fn offsetOf(bytes: []const u8, tag: record.Tag) !usize {
+    var r: std.Io.Reader = .fixed(bytes);
+    try r.discardAll(10);
+    while (r.bufferedLen() != 0) {
+        const offset = r.seek;
+        const header = try record.Header.decode(&r);
+        if (header.tag == tag) return offset;
+        try r.discardAll(header.payload_len);
+    }
+    return error.MissingRecord;
+}
+
+fn withEmptyKitty(bytes: []const u8) ![]u8 {
+    const offset = try offsetOf(bytes, .continuation);
+    var result: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer result.deinit();
+    try result.writer.writeAll(bytes[0..offset]);
+    var payload: [19]u8 = @splat(0);
+    std.mem.writeInt(u32, payload[2..6], 41, .little);
+    std.mem.writeInt(u32, payload[6..10], 51, .little);
+    try record.testWriteRaw(&result.writer, 8, &payload);
+    try result.writer.writeAll(bytes[offset..]);
+    return result.toOwnedSlice();
+}
+
+pub fn fixChecksum(bytes: []u8, offset: usize) !void {
+    var r: std.Io.Reader = .fixed(bytes[offset..]);
+    const header = try record.Header.decode(&r);
+    var crc: record.Checksum = .init(header.tag, header.payload_len);
+    try crc.writer().writeAll(try r.take(header.payload_len));
+    std.mem.writeInt(u32, bytes[offset + 6 ..][0..4], crc.final(), .little);
+}
