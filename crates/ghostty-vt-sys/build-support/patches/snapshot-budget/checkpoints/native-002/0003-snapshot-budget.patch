+//! Allocation-free admission pass for the raw-v1 budget profile.
+const std = @import("std");
+const envelope = @import("envelope.zig");
+const record = @import("record.zig");
+const terminal = @import("terminal.zig");
+const screen = @import("screen.zig");
+const page = @import("page.zig");
+const history = @import("history.zig");
+const guard = @import("../snapshot_budget_guard.zig");
+
+pub fn check(bytes: []const u8, options: anytype, scope: *guard.Scope, offset: *u64) !void {
+    var reader: std.Io.Reader = .fixed(bytes);
+    defer offset.* = reader.seek;
+    try envelope.decode(&reader);
+    var records: u64 = 0;
+    var pages: u64 = 0;
+    var cells: u64 = 0;
+    var rows: u64 = 0;
+    var history_rows: u64 = 0;
+    var active_rows: u64 = 0;
+    var terminal_seen = false;
+    var last: record.Tag = .terminal;
+    while (reader.bufferedLen() != 0) {
+        const header = try record.Header.decode(&reader);
+        records += 1;
+        if (records > options.max_records) return error.LimitExceeded;
+        // Two byte passes, admission checksum and the native decoder.
+        try scope.chargeWork(2 * @as(u64, header.payload_len) + record.Header.len);
+        const payload = try reader.take(header.payload_len);
+        var source: std.Io.Reader = .fixed(payload);
+        switch (header.tag) {
+            .terminal => {
+                if (terminal_seen) return error.DuplicateTerminal;
+                terminal_seen = true;
+                const value = try terminal.Header.decode(&source);
+                active_rows = @as(u64, value.rows) * value.screen_count;
+                if (value.columns > options.max_columns or value.rows > options.max_rows or
+                    value.width_px > options.max_pixel_width or value.height_px > options.max_pixel_height)
+                    return error.LimitExceeded;
+                if (value.columns > 4096 or value.rows > 4096) return error.UnsupportedProfile;
+                cells = std.math.add(u64, cells, @as(u64, value.columns) * value.rows * value.screen_count) catch
+                    return error.LimitExceeded;
+            },
+            .screen => {
+                const value = try screen.Header.decode(&source);
+                if (value.page_count > options.max_pages) return error.LimitExceeded;
+                if (value.history_rows > options.max_history_rows - history_rows)
+                    return error.LimitExceeded;
+                history_rows += value.history_rows;
+            },
+            .page => {
+                const value = try page.Header.decode(&source);
+                pages += 1;
+                if (pages > options.max_pages or value.columns > options.max_columns or
+                    value.rows > options.max_page_rows) return error.LimitExceeded;
+                const count = @as(u64, value.columns) * value.rows;
+                // Keep native offset/layout arithmetic below 32-bit limits,
+                // even when the caller supplies very large policy values.
+                if (value.columns > 4096 or count > guard.max_page_cells or
+                    value.grapheme_capacity_bytes > 64 * 1024 * 1024 or
+                    value.string_capacity_bytes > 64 * 1024 * 1024) return error.UnsupportedProfile;
+                cells = std.math.add(u64, cells, count) catch return error.LimitExceeded;
+                rows += value.rows;
+                // Charge grid traversal plus worst-case linear table probes.
+                // Fixed 65536-slot ID remap initialization is charged by its
+                // allocation. No decompressor is reachable in this profile.
+                const probes = 1 + @as(u64, value.style_count) + value.hyperlink_count;
+                const comparisons = std.math.mul(u64, count * probes, @as(u64, payload.len) + 1) catch
+                    return error.LimitExceeded;
+                try scope.chargeWork(comparisons);
+                // Also admit worst-case comparisons while constructing tables.
+                try scope.chargeWork(@as(u64, payload.len) * payload.len);
+            },
+            .history => {
+                const value = try history.Header.decode(&source);
+                if (value.page_count > options.max_pages) return error.LimitExceeded;
+            },
+            .continuation => {
+                if (payload.len > options.max_continuation_bytes) return error.LimitExceeded;
+                const replay_work = std.math.mul(u64, payload.len, payload.len) catch
+                    return error.LimitExceeded;
+                try scope.chargeWork(replay_work);
+            },
+            .kitty_image_storage => {
+                // Matching encoders emit this even with no images. Preserve
+                // the two ID counters, but admit no image/placement/load.
+                if (comptime !@import("terminal_options").kitty_graphics)
+                    return error.UnsupportedProfile;
+                if (payload.len != 19) return error.UnsupportedProfile;
+                if (std.mem.readInt(u32, payload[10..14], .little) != 0 or
+                    std.mem.readInt(u32, payload[14..18], .little) != 0 or
+                    payload[18] != 0) return error.UnsupportedProfile;
+            },
+            .ready, .finish => {},
+            // Reject rather than silently skip images or future extensions.
+            else => return error.UnsupportedProfile,
+        }
