+//! Private staged body encoder. Public wrapper owns State/body publication.
+const std = @import("std");
+const build_options = @import("terminal_options");
+const terminal_c = @import("terminal.zig");
+const snapshot = @import("../snapshot/main.zig");
+const preflight = @import("../snapshot/budget_preflight.zig");
+const guard = @import("../snapshot_budget_guard.zig");
+
+pub const Body = struct {
+    allocation: []u8,
+    len: usize,
+
+    pub fn bytes(self: Body) []const u8 {
+        return self.allocation[0..self.len];
+    }
+
+    pub fn deinit(self: Body) void {
+        guard.heapAllocator().free(self.allocation);
+    }
+};
+
+/// Caller holds exclusive source ownership and has captured/validated the
+/// shared profile State. This helper invokes no caller callbacks and mutates
+/// neither the source parser nor its pages. No output buffer escapes on error.
+pub fn create(
+    source: terminal_c.Terminal,
+    options: anytype,
+    scope: *guard.Scope,
+    capacity: usize,
+) !Body {
+    const native = terminal_c.zigTerminal(source) orelse return error.InvalidValue;
+    if (options.terminal_profile != 0) return error.UnsupportedProfile;
+    if (capacity == 0) return error.OutOfSpace;
+    try admitSource(native, options, scope);
+    const alloc = guard.heapAllocator();
+    const max_bytes = std.math.cast(usize, options.max_encoded_bytes) orelse return error.UnsupportedProfile;
+    const max_tail = std.math.cast(usize, options.max_continuation_bytes) orelse return error.UnsupportedProfile;
+    const tail = try alloc.alloc(u8, @min(max_tail, max_bytes));
+    defer alloc.free(tail);
+    var tail_writer: std.Io.Writer = .fixed(tail);
+    terminal_c.continuationWriteIo(source, &tail_writer) catch |err| switch (err) {
+        error.WriteFailed => return error.LimitExceeded,
+        error.ContinuationDisabled => {
+            // The existing checked helper accepts disabled tracking only if
+            // the source is provably ground, without guessing a missing tail.
+            const empty = try terminal_c.continuationAllocIo(source, alloc, true);
+            defer alloc.free(empty);
+            if (empty.len != 0) return error.InvalidContinuation;
+        },
+        else => return err,
+    };
+    const continuation = tail_writer.buffered();
+    try scope.chargeWork(std.math.mul(u64, continuation.len, continuation.len) catch return error.LimitExceeded);
+    const stage = try alloc.alloc(u8, @min(capacity, max_bytes));
+    errdefer alloc.free(stage);
+    var writer: std.Io.Writer = .fixed(stage);
+    snapshot.encode(alloc, &writer, native, .{
+        .continuation = if (continuation.len == 0) .ground else .{ .bytes = continuation },
+        .emit_empty_kitty_storage = true,
+    }) catch |err| switch (err) {
+        error.WriteFailed => return if (scope.allocation_failed) error.OutOfMemory else if (capacity < max_bytes) error.OutOfSpace else error.LimitExceeded,
+        else => return err,
+    };
+    if (scope.failed()) return error.OutOfMemory;
+    var offset: u64 = 0;
+    try preflight.check(writer.buffered(), options, scope, &offset);
+    return .{ .allocation = stage, .len = writer.end };
+}
+
+fn admitSource(native: *const terminal_c.ZigTerminal, options: anytype, scope: *guard.Scope) !void {
+    if (native.cols > options.max_columns or native.rows > options.max_rows or
+        native.width_px > options.max_pixel_width or native.height_px > options.max_pixel_height)
+        return error.LimitExceeded;
+    if (native.cols > 4096 or native.rows > 4096) return error.UnsupportedProfile;
+    if (native.pwd.items.len > options.max_encoded_bytes or native.title.items.len > options.max_encoded_bytes)
+        return error.LimitExceeded;
+    try scope.chargeWork(std.math.mul(u64, native.pwd.items.len, native.pwd.items.len) catch return error.LimitExceeded);
+    try scope.chargeWork(std.math.mul(u64, native.title.items.len, native.title.items.len) catch return error.LimitExceeded);
+    var pages: u64 = 0;
+    var cells: u64 = 0;
+    var history_rows: u64 = 0;
+    var screens = native.screens.all;
+    var it = screens.iterator();
+    while (it.next()) |entry| {
+        const screen = entry.value.*;
+        if (screen.pages.total_rows < native.rows) return error.InvalidValue;
+        const rows = screen.pages.total_rows - native.rows;
+        if (rows > options.max_history_rows - history_rows) return error.LimitExceeded;
+        history_rows += rows;
+        if (comptime build_options.kitty_graphics) {
+            const storage = &screen.kitty_images;
+            if (storage.images.count() != 0 or storage.placements.count() != 0 or storage.loading != null)
+                return error.UnsupportedProfile;
+            if (storage.total_limit != options.runtime_image_storage_limit or storage.image_limits.file or
+                storage.image_limits.shared_memory or storage.image_limits.temporary_file != .disabled)
+                return error.UnsupportedProfile;
+        } else if (options.runtime_image_storage_limit != 0) return error.UnsupportedProfile;
+        var node = screen.pages.pages.first;
+        while (node) |current| : (node = current.next) {
+            pages += 1;
+            if (pages > options.max_pages) return error.LimitExceeded;
+            // Wire PAGEs are raw, but preserving a compressed source page
+            // would decompress it. That work is not admitted by raw-v1.
+            const page = current.pageIfResident() orelse return error.UnsupportedProfile;
+            if (page.size.cols > options.max_columns or page.size.rows > options.max_page_rows)
+                return error.LimitExceeded;
+            const count = @as(u64, page.size.cols) * page.size.rows;
+            if (page.size.cols > 4096 or count > guard.max_page_cells or
+                page.capacity.grapheme_bytes > 64 * 1024 * 1024 or
+                page.capacity.string_bytes > 64 * 1024 * 1024) return error.UnsupportedProfile;
+            if (count > options.max_cells - cells) return error.LimitExceeded;
+            cells += count;
+            try scope.chargeWork(page.memory.len);
+            const probes = 1 + @as(u64, page.capacity.styles) + page.capacity.hyperlink_cells;
+            const work = std.math.mul(u64, count, probes) catch return error.LimitExceeded;
+            try scope.chargeWork(work);
+        }
+    }
+    const screen_count: u64 = native.screens.all.count();
+    if (pages + 3 * screen_count + 4 > options.max_records) return error.LimitExceeded;
+}
