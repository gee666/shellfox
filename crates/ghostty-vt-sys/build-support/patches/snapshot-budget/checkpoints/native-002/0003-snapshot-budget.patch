+pub fn fixture(input: []const u8) ![]u8 {
+    var source: terminal.Terminal = null;
+    try testing.expectEqual(Result.success, terminal.new(&lib.alloc.test_allocator, &source, 8, 3));
+    defer terminal.free(source);
+    terminal.zigTerminal(source).?.setScrollbackMaxBytes(16 * 1024 * 1024);
+    const continuation: usize = 4096;
+    try testing.expectEqual(Result.success, terminal.set(source, .continuation_max_bytes, &continuation));
+    terminal.vt_write(source, input.ptr, input.len);
+    var ptr: ?[*]u8 = null;
+    var len: usize = 0;
+    try testing.expectEqual(Result.success, snapshot.encode_alloc(source, null, &ptr, &len));
+    return ptr.?[0..len];
