+    .engine_profile = lib.String.init(@as([]const u8, @import("terminal_options").shellfox_engine_profile)),
+    .profile_state = .{ .terminal_profile = 0, .preceding_join = 0 },
+    .max_encoded_bytes = 4 * 1024 * 1024,
+    .max_allocation_bytes = 128 * 1024 * 1024,
+    .max_work_units = 100000000000,
+    .max_cells = 1000000,
+    .max_history_rows = 100000,
