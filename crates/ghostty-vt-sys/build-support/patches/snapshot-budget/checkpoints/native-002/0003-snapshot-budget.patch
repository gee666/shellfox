+        var framed: record.Reader = undefined;
+        framed.initHeader(&crc_source, header);
+        try framed.payloadReader().discardAll(payload.len);
+        try framed.finish();
+        last = header.tag;
+        if (last == .finish and reader.bufferedLen() != 0) return error.TrailingData;
+    }
+    if (last != .finish) return error.MissingFinish;
+}
