+//! Synchronous snapshot decode accounting. No allocator retains a scope pointer.
+const std = @import("std");
+const builtin = @import("builtin");
+const Allocator = std.mem.Allocator;
+
+// Leave room for staging/cursor references in the native u16 refcounts.
+pub const max_page_cells: u64 = 65000;
+
+pub const Scope = struct {
+    max_bytes: u64,
+    max_work: u64,
+    heap_bytes: u64 = 0,
+    mapped_bytes: u64 = 0,
+    work: u64 = 0,
+    exceeded: bool = false,
+    allocation_failed: bool = false,
+
+    pub fn failed(self: *const Scope) bool {
+        return self.exceeded or self.allocation_failed;
+    }
+
+    pub fn chargeWork(self: *Scope, n: u64) error{OutOfMemory}!void {
+        if (n > self.max_work - self.work) {
+            self.exceeded = true;
+            return error.OutOfMemory;
+        }
+        self.work += n;
+    }
+
+    fn charge(self: *Scope, n: usize, mapped: bool) error{OutOfMemory}!void {
+        // Windows reservations have 64 KiB allocation granularity. Other
+        // targets round to their runtime OS page size, including 16 KiB Apple.
+        const granularity: u64 = if (builtin.os.tag == .windows) 65536 else std.heap.pageSize();
+        const rounded = std.math.add(u64, n, granularity - 1) catch {
+            self.exceeded = true;
+            return error.OutOfMemory;
+        };
+        const bytes = rounded / granularity * granularity;
+        if (bytes > self.max_bytes - self.heap_bytes - self.mapped_bytes) {
+            self.exceeded = true;
+            return error.OutOfMemory;
+        }
+        try self.chargeWork(bytes);
+        if (mapped) self.mapped_bytes += bytes else self.heap_bytes += bytes;
+    }
+};
+
+threadlocal var active: ?*Scope = null;
+
+pub fn enter(scope: *Scope) bool {
+    if (active != null) return false;
+    active = scope;
+    return true;
+}
+
+pub fn isActive() bool {
+    return active != null;
+}
+
+pub fn leave() void {
+    active = null;
+}
+
+pub fn allocationFailed() void {
+    if (active) |scope| scope.allocation_failed = true;
+}
+
+pub fn chargeMapped(n: usize) error{OutOfMemory}!void {
+    if (active) |scope| try scope.charge(n, true);
+}
+
+// OS allocations have no hidden per-object heap metadata. Tests use the
+// testing allocator to detect leaks, but retain the production charge policy.
+const heap_backend = if (builtin.is_test) std.testing.allocator else std.heap.page_allocator;
+
+pub fn heapAllocator() Allocator {
+    return wrap(&heap_backend, false);
+}
+
+pub fn wrap(backend: *const Allocator, mapped: bool) Allocator {
+    return .{
+        .ptr = @constCast(backend),
+        .vtable = if (mapped) &mapped_vtable else &heap_vtable,
+    };
+}
+
+const heap_vtable: Allocator.VTable = .{
+    .alloc = Heap.alloc,
+    .resize = Allocator.noResize,
+    .remap = Allocator.noRemap,
+    .free = free,
+};
+const mapped_vtable: Allocator.VTable = .{
+    .alloc = Mapped.alloc,
+    .resize = Allocator.noResize,
+    .remap = Allocator.noRemap,
+    .free = free,
+};
+const Heap = Functions(false);
+const Mapped = Functions(true);
+
+fn Functions(comptime mapped: bool) type {
+    return struct {
+        fn alloc(ctx: *anyopaque, len: usize, alignment: std.mem.Alignment, ra: usize) ?[*]u8 {
+            if (active) |scope| {
+                var reservation = len;
+                if (alignment.toByteUnits() > std.heap.pageSize()) {
+                    // OS page allocators can allocate/drop an initial mapping
+                    // and over-allocate another to satisfy large alignment.
+                    // Charge both transient reservations conservatively.
+                    const expanded = std.math.add(usize, len, alignment.toByteUnits()) catch {
+                        scope.exceeded = true;
+                        return null;
+                    };
+                    reservation = std.math.mul(usize, expanded, 2) catch {
+                        scope.exceeded = true;
+                        return null;
+                    };
+                }
+                scope.charge(reservation, mapped) catch return null;
+            }
+            const backend: *const Allocator = @ptrCast(@alignCast(ctx));
+            const result = backend.rawAlloc(len, alignment, ra);
+            if (result == null) allocationFailed();
+            return result;
+        }
+    };
+}
+
+fn free(ctx: *anyopaque, memory: []u8, alignment: std.mem.Alignment, ra: usize) void {
+    const backend: *const Allocator = @ptrCast(@alignCast(ctx));
+    backend.rawFree(memory, alignment, ra);
+}
+
+test "snapshot budget charges cumulative heap and direct mappings" {
+    var scope: Scope = .{ .max_bytes = 65536, .max_work = 1000000 };
+    try std.testing.expect(enter(&scope));
+    defer leave();
+    const alloc = heapAllocator();
+    const first = try alloc.alloc(u8, 1);
+    alloc.free(first);
+    try std.testing.expect(scope.heap_bytes > 0);
+    try std.testing.expectError(error.OutOfMemory, chargeMapped(65536));
+    try std.testing.expect(scope.exceeded);
+}
+
+test "snapshot budget accounts for transient over-aligned OS reservations" {
+    var scope: Scope = .{ .max_bytes = 65536, .max_work = 10000000 };
+    try std.testing.expect(enter(&scope));
+    defer leave();
+    try std.testing.expectError(error.OutOfMemory, heapAllocator().alignedAlloc(
+        u8,
+        .fromByteUnits(131072),
+        1,
+    ));
+    try std.testing.expect(scope.exceeded);
+    try std.testing.expectEqual(@as(u64, 0), scope.heap_bytes);
+}
+
+test "snapshot budget poisons a recovered backend allocation failure" {
+    var scope: Scope = .{ .max_bytes = 1000000, .max_work = 1000000 };
+    try std.testing.expect(enter(&scope));
+    defer leave();
+    const backend = Allocator.failing;
+    const allocator = wrap(&backend, false);
+    try std.testing.expectError(error.OutOfMemory, allocator.alloc(u8, 1));
+    try std.testing.expect(scope.failed());
+    try std.testing.expect(scope.allocation_failed);
+    try std.testing.expect(!scope.exceeded);
+}
