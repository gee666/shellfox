+#define GHOSTTY_SNAPSHOT_BUDGET_RAW_V1 1u
+#define GHOSTTY_SNAPSHOT_BUDGET_GHOSTTY_1_0_1 0x00010001u
+#define GHOSTTY_SNAPSHOT_BUDGET_IMAGE_IO_DIRECT_ONLY 0u
+#define GHOSTTY_SNAPSHOT_BUDGET_PULL_SCROLLBACK_DISABLED 0u
+#define GHOSTTY_SNAPSHOT_BUDGET_PULL_SCROLLBACK_ENABLED 1u
