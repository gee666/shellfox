+/* Exact size and ABI version required. All limits are finite; zero means zero,
+ * never unlimited. RAW_V1 rejects unknown records, nonempty Kitty image,
+ * placement/load state and history recompression. Empty Kitty storage markers
+ * are accepted. Nonzero flags/reserved or image/decompression limits
+ * return GHOSTTY_UNSUPPORTED, not a lossy terminal. No allocator/reader/effects
+ * callbacks are accepted. Caller-owned input must remain immutable during call.
+ * Only canonical C-stream settings are admitted. Pending APC builders and
+ * unencoded sessions are unsupported; destination callbacks/permissions are
+ * not restored. See runtime-config.md for the exact restoration policy.
+ * max_allocation_bytes bounds cumulative OS-rounded heap and page reservations,
+ * including temporary allocations. Frees do not refund the budget. This is not
+ * a process RSS limit and does not include caller input, stacks or library code.
+ * max_work_units bounds deterministic admission work, not elapsed CPU time.
+ * See the patch README for the exact accounting formula and supported profile.
+ */
+typedef struct {
+  size_t size;
+  uint32_t abi_version;
+  uint32_t profile;
+  uint32_t ghostty_version;
+  uint32_t snapshot_version;
+  /* Declared engine identity is compatibility metadata, not authenticity.
+   * Capture State at the exact input cut with the atomic encoder companion.
+   * Raw snapshot v1 does not carry it. Never serialize State padding.
+   */
+  GhosttyString engine_profile;
+  GhosttyShellfoxTerminalProfileState profile_state;
+  uint32_t flags;
+  uint32_t reserved;
+  uint64_t max_encoded_bytes;
+  uint64_t max_allocation_bytes;
+  uint64_t max_work_units;
+  uint64_t max_cells;
+  uint64_t max_history_rows;
+  uint64_t max_continuation_bytes;
+  uint64_t max_image_bytes;
+  uint64_t max_decompressed_bytes;
+  /* Explicit post-decode configuration, NOT an image decode budget. The
+   * source envelope must declare the exact per-screen limit. No guessed
+   * default is supplied. Direct-only IO is the only admitted runtime policy.
+   */
+  uint64_t runtime_image_storage_limit;
+  uint32_t runtime_image_io_policy;
+  /* Required explicit 0/1, not encoded by raw-v1; applied before continuation. */
+  uint32_t runtime_resize_pull_scrollback;
+  uint32_t max_columns;
+  uint32_t max_rows;
+  uint32_t max_pixel_width;
+  uint32_t max_pixel_height;
+  uint32_t max_page_rows;
+  uint32_t max_pages;
+  uint32_t max_records;
+  uint32_t max_images;
