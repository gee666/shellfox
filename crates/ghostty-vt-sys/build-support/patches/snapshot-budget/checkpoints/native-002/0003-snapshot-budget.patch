+//! Atomic State/body publication under the caller's exclusive terminal ownership.
+const std = @import("std");
+const lib = @import("../lib.zig");
+const Result = @import("result.zig").Result;
+const terminal_c = @import("terminal.zig");
+const budget = @import("shellfox_snapshot_budget.zig");
+const body_encoder = @import("snapshot_budget_encode.zig");
+const guard = @import("../snapshot_budget_guard.zig");
+const profile = @import("../shellfox_terminal_profile.zig");
+
+pub const Options = extern struct {
+    size: usize = @sizeOf(Options),
+    abi_version: u32 = 1,
+    profile: u32 = 1,
+    ghostty_version: u32 = 0x00010001,
+    snapshot_version: u32 = 1,
+    engine_profile: lib.String,
+    terminal_profile: u32 = 0,
+    flags: u32 = 0,
+    reserved: u32 = 0,
+    max_encoded_bytes: u64,
+    max_allocation_bytes: u64,
+    max_work_units: u64,
+    max_cells: u64,
+    max_history_rows: u64,
+    max_continuation_bytes: u64,
+    max_image_bytes: u64 = 0,
+    max_decompressed_bytes: u64 = 0,
+    runtime_image_storage_limit: u64,
+    runtime_image_io_policy: u32 = 0,
+    runtime_resize_pull_scrollback: u32,
+    max_columns: u32,
+    max_rows: u32,
+    max_pixel_width: u32,
+    max_pixel_height: u32,
+    max_page_rows: u32,
+    max_pages: u32,
+    max_records: u32,
+    max_images: u32 = 0,
+};
+
+pub fn encode_buf(
+    source: terminal_c.Terminal,
+    options_: ?*const Options,
+    output_: ?[*]u8,
+    capacity: usize,
+    written_: ?*usize,
+    state_: ?*profile.State,
+    report: ?*budget.Report,
+) callconv(lib.calling_conv) Result {
+    const written = written_ orelse return .invalid_value;
+    written.* = 0;
+    const state = state_ orelse return .invalid_value;
+    if (state.size != @sizeOf(profile.State)) return .invalid_value;
+    if (state.abi_version != profile.abi_version) return .unsupported;
+    // No valid-looking captured State is left behind on a failed transaction.
+    state.* = .{ .size = 0, .abi_version = 0, .terminal_profile = std.math.maxInt(u32), .preceding_join = 0 };
+    if (comptime !budget.supported_build) return .unsupported;
+    const options_ptr = options_ orelse return .invalid_value;
+    if (options_ptr.size != @sizeOf(Options)) return .invalid_value;
+    const options = options_ptr.*;
+    if (report) |r| {
+        if (r.size != @sizeOf(budget.Report)) return .invalid_value;
+        if (r.abi_version != 1 or r.reserved != 0) return .unsupported;
+        r.* = .{};
+    }
+    const compatible = budget.validateCommon(options);
+    if (compatible != .success) return compatible;
+    if (options.terminal_profile != profile.Native) return .unsupported;
+    const output = output_ orelse return .invalid_value;
+    const native = terminal_c.zigTerminal(source) orelse return .invalid_value;
+    var scope: guard.Scope = .{ .max_bytes = options.max_allocation_bytes, .max_work = options.max_work_units };
+    if (!guard.enter(&scope)) return .unsupported;
+    defer guard.leave();
+    defer if (report) |r| {
+        r.heap_bytes = scope.heap_bytes;
+        r.mapped_bytes = scope.mapped_bytes;
+        r.work_units = scope.work;
+    };
+    if (!terminal_c.budgetRawV1ConfigSupported(source)) return .unsupported;
+    if (native.flags.resize_pull_scrollback != (options.runtime_resize_pull_scrollback == 1))
+        return .unsupported;
+    const captured = profile.capture(native) catch |err| return budget.mapError(err, scope.exceeded);
+    if (captured.terminal_profile != options.terminal_profile) return .unsupported;
+    const body = body_encoder.create(source, options, &scope, capacity) catch |err|
+        return budget.mapError(err, scope.exceeded);
+    defer body.deinit();
+    const after = profile.capture(native) catch |err| return budget.mapError(err, scope.exceeded);
+    if (after.terminal_profile != captured.terminal_profile or after.preceding_join != captured.preceding_join)
+        return .invalid_value;
+    if (scope.failed()) return budget.mapError(error.OutOfMemory, scope.exceeded);
+    // All validation and allocations precede writes to caller-owned outputs.
+    // Outputs must be disjoint and must not alias source-owned storage.
+    @memcpy(output[0..body.len], body.bytes());
+    state.* = captured;
+    written.* = body.len;
+    return .success;
+}
+
+test {
+    if (!@import("terminal_options").slow_runtime_safety and lib.feature(.snapshot)) {
+        _ = @import("snapshot_budget_encode_tests.zig");
+        _ = @import("snapshot_budget_policy_tests.zig");
+    }
+}
