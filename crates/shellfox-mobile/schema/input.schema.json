{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shellfox mobile terminal input ABI v1",
  "description": "Strict UTF-8 JSON, at most 65536 encoded bytes. The platform reports its keyboard editor's committed text after every keyboard edit (marked text excluded) and resets it after Enter or any key; Rust sends the terminal the difference. Keys are Ghostty key events. Ghostty encodes all terminal input.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "editor"
        },
        "committed": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        }
      },
      "required": [
        "type",
        "committed"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "editorReset"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "paste"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "key"
        },
        "event": {
          "type": "object",
          "properties": {
            "physical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 175,
              "description": "Public GhosttyKey number (libghostty-vt 1.0.1 key/event.h)."
            },
            "action": {
              "enum": [
                "press",
                "repeat",
                "release"
              ]
            },
            "modifiers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023,
              "description": "GhosttyMods bits: shift=1 ctrl=2 alt=4 super=8 caps=16 num=32, side bits 64..512."
            },
            "consumedModifiers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            },
            "text": {
              "type": "string",
              "description": "Layout text without Ctrl; no C0, DEL or U+F700-U+F8FF."
            },
            "unshiftedCodepoint": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 1114111,
              "not": {
                "minimum": 55296,
                "maximum": 57343
              }
            },
            "composing": {
              "type": "boolean"
            }
          },
          "required": [
            "physical",
            "action",
            "modifiers",
            "consumedModifiers",
            "text",
            "unshiftedCodepoint",
            "composing"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "event"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "mouse"
        },
        "action": {
          "enum": [
            "press",
            "release",
            "motion"
          ]
        },
        "button": {
          "enum": [
            null,
            "left",
            "middle",
            "right",
            "wheelUp",
            "wheelDown",
            "wheelLeft",
            "wheelRight",
            "back",
            "forward"
          ]
        },
        "modifiers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "default": 0
        },
        "x": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "cellWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "cellHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "anyButtonPressed": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "action",
        "x",
        "y",
        "cellWidth",
        "cellHeight",
        "anyButtonPressed"
      ],
      "additionalProperties": false
    }
  ]
}
