{
  "name": "shellfox",
  "productName": "Shellfox",
  "version": "0.3.5",
  "description": "Shellfox — terminal manager",
  "author": "Shellfox contributors",
  "license": "MIT",
  "private": true,
  "main": "tmp/build/main/index.cjs",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:native": "node scripts/native.mjs test",
    "build:native": "node scripts/native.mjs publish",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "test:e2e": "node scripts/verify.mjs e2e",
    "test:windows": "node scripts/verify.mjs windows",
    "package": "node scripts/forge.mjs package",
    "make": "node scripts/forge.mjs make",
    "test:packaged": "node scripts/package-smoke.mjs",
    "test:packaged:startup": "node scripts/package-ui-smoke.mjs",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "rebuild": "node scripts/rebuild.mjs",
    "test:storage": "node scripts/storage-test.mjs",
    "test:pty": "node scripts/pty-test.mjs",
    "build:terminal-native": "node scripts/terminal-native.mjs",
    "test:terminal-native": "node scripts/terminal-native-preflight.mjs",
    "test:packaging": "node --test scripts/packaging.test.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron/asar": "4.3.1",
    "@electron/rebuild": "4.0.3",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.5.1",
    "esbuild": "0.27.3",
    "jsdom": "28.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
